                            "SQC_PERF_SEL_ICACHE_GATCL1_STALL_LRU_INFLIGHT: Total ICACHE gatcl1 stalls due to LRU cache line with traffic inflight " = 0xfe, 
                            "SQC_PERF_SEL_ICACHE_GATCL1_LFIFO_FULL: Total ICACHE gatcl1 atcl2 latency hiding fifo full cycles " = 0xff, 
