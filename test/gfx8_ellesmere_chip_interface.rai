                            "Put MC anti-glitch mux to use MPLL output " = 0x1 }  ;
    SPARE_1  12:12  NUM ;
    QDR  13:13  ALPHA {"Run MPLL in GDDR3 mode. MCLK=YCLK/4 " = 0x0, 
                            "Run MPLL in GDDR5 mode (quad-data-rate). MCLK=YCLK/8 " = 0x1 }  ;
    MPLL_CTLREQ  14:14  ALPHA {"MPLL Indirect Mode: Asserting this bit will trigger an update sequence of the MPLL control. Before writing to this bit, MPLL_FUNC_CNTL, MPLL_FUNC_CNTL_1, MPLL_FUNC_CNTL_2, MPLL_AD_FUNC_CNTL, MPLL_DQ_FUNC_CNTL should already contain the new set of value " = 0x1 }  ;
    MPLL_CHG_STATUS  16:16  ALPHA {"MPLL indirect mode: Previous MPLL_CTLREQ has been completed. SW should not issue another write to this register until this bit is asserted " = 0x1 }  R;
    FORCE_TESTMODE  17:17  ALPHA {"Normal Mode " = 0x0, 
                            "Force MC MCLK into testmode for debug " = 0x1 }  ;
    FAST_LOCK_EN  20:20  ALPHA {"Normal Mode " = 0x0, 
