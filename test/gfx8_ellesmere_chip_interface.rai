                            "SQC_PERF_SEL_DCACHE_CACHE_STALL_OUTPUT_TC_IF: Number of cycles stalled because the TC request interface is stalled.  (per-Bank, nondeterministic, unwindowed) " = 0xe6, 
                            "SQC_PERF_SEL_DCACHE_STALL_OUTXBAR_ARB_NO_GRANT: Number of arbitration stalls due to lost arbitration for the output port.  (per-Bank, nondeterministic, unwindowed) " = 0xe7, 
                            "SQC_PERF_SEL_DCACHE_REQ_READ_1: Number of constant cache 1 dw read requests.  (per-SQ) " = 0xe8, 
                            "SQC_PERF_SEL_DCACHE_REQ_READ_2: Number of constant cache 2 dw read requests.  (per-SQ) " = 0xe9, 
                            "SQC_PERF_SEL_DCACHE_REQ_READ_4: Number of constant cache 4 dw read requests.  (per-SQ) " = 0xea, 
                            "SQC_PERF_SEL_DCACHE_REQ_READ_8: Number of constant cache 8 dw read requests.  (per-SQ) " = 0xeb, 
                            "SQC_PERF_SEL_DCACHE_REQ_READ_16: Number of constant cache 16 dw read requests.  (per-SQ) " = 0xec, 
                            "SQC_PERF_SEL_DCACHE_REQ_TIME: Number of constant cache timestamp requests.  (per-SQ) " = 0xed, 
                            "SQC_PERF_SEL_DCACHE_REQ_WRITE_1: Number of constant cache 1 dw write requests.  (per-SQ) " = 0xee, 
                            "SQC_PERF_SEL_DCACHE_REQ_WRITE_2: Number of constant cache 2 dw write requests.  (per-SQ) " = 0xef, 
                            "SQC_PERF_SEL_DCACHE_REQ_WRITE_4: Number of constant cache 4 dw write requests.  (per-SQ) " = 0xf0, 
                            "SQC_PERF_SEL_DCACHE_REQ_ATC_PROBE: Number of constant cache atc probe requests.  (per-SQ) " = 0xf1, 
                            "SQC_PERF_SEL_SQ_DCACHE_REQS: Number of constant requests from SQ before any serialization (per-SQ) " = 0xf2, 
                            "SQC_PERF_SEL_DCACHE_FLAT_REQ: Number of constant flat requests (per-SQ) " = 0xf3, 
                            "SQC_PERF_SEL_DCACHE_NONFLAT_REQ: Number of constant non-flat requests (per-SQ) " = 0xf4, 
                            "SQC_PERF_SEL_ICACHE_INFLIGHT_LEVEL: Level Counter: # total outstanding transactions in instruction cache (per-SQ, nondeterministic) " = 0xf5, 
                            "SQC_PERF_SEL_DCACHE_INFLIGHT_LEVEL: Level Counter: # total outstanding transactions in data cache (per-SQ, nondeterministic) " = 0xf6, 
                            "SQC_PERF_SEL_TC_INFLIGHT_LEVEL: Level Counter: total outstanding requests to TC (No-Masking, nondeterministic) " = 0xf7, 
