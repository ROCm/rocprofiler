    SPARE_2  23:23  NUM ;
    SS_SSEN  25:24  ALPHA {"Disable MPLL Spread Spectrum, see MPLL spec for more details " = 0x0, 
                            "Enable internal MPLL Spread Spectrurm, see MPLL spec for more details " = 0x1 }  ;
    SS_DSMODE_EN  26:26  ALPHA {"MPLL Delta-sigma modulation disable, see MPLL spec for more details " = 0x0, 
                            "MPLL Delta-sigma modulation enable, see MPLL spec for more details " = 0x1 }  ;
    VTOI_BIAS_CNTRL  27:27  NUM ;
    SPARE_3  30:28  NUM ;
    GLOBAL_MPLL_RESET  31:31  ALPHA {"Individual mpll reset controls reset " = 0x0, 
