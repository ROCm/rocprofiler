                            "511 sclk cycles " = 0x2, 
                            "1023 sclk cycles " = 0x3 }  ;
    RD_STALL_TIMER  12:11  ALPHA {"2 sclk cycles per urgency level " = 0x0, 
                            "4 sclk cycles per urgency level " = 0x1, 
                            "8 sclk cycles per urgency level " = 0x2, 
                            "16 sclk cycles per urgency level " = 0x3 }  ;
    WRITE_COMBINE_TIMER  20:19  ALPHA {"7 sclk cycles timeout " = 0x0, 
                            "15 sclk cycles timeout " = 0x1, 
                            "31 sclk cycles timeout " = 0x2, 
                            "63 sclk cycles timeout " = 0x3 }  ;
    WRITE_COMBINE_EN  21:21  NUM ;
    CACHE_INVALIDATE  22:22  NUM ;
    CLOCK_GATING_DIS  23:23  NUM ;
    REG_CLK_ENABLE_COUNT  27:24  NUM ;
    ALL_SURFACES_DIS  29:29  ALPHA {"All surfaces enabled " = 0x0, 
                            "All surfaces disabled " = 0x1 }  ;
    WRITE_THROUGH_CACHE_DIS  30:30  ALPHA {"Writes that hit the read cache will update it " = 0x0, 
                            "Writes will invalidate the read cache " = 0x1 }  ;
    LIN_RD_CACHE_DIS  31:31  ALPHA {"Frame buffer reads taken from read cache if possible. " = 0x0, 
                            "Frame buffer reads always sent to memory. " = 0x1 }  ;
};

