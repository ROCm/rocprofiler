                            "SQC_PERF_SEL_DCACHE_GATCL1_STALL_INFLIGHT_MAX: Total DCACHE gatcl1 stalls due to inflight counter saturation " = 0x107, 
                            "SQC_PERF_SEL_DCACHE_GATCL1_STALL_LRU_INFLIGHT: Total DCACHE gatcl1 stalls due to LRU cache line with traffic inflight " = 0x108, 
                            "SQC_PERF_SEL_DCACHE_GATCL1_LFIFO_FULL: Total DCACHE gatcl1 atcl2 latency hiding fifo full cycles " = 0x109, 
                            "SQC_PERF_SEL_DCACHE_GATCL1_STALL_LFIFO_NOT_RES: Total DCACHE gatcl1 stalls due to atcl2 latency hiding fifo output not resident " = 0x10a, 
                            "SQC_PERF_SEL_DCACHE_GATCL1_STALL_ATCL2_REQ_OUT_OF_CREDITS: Total DCACHE gatcl1 stalls due to atcl2_req out of credits " = 0x10b, 
                            "SQC_PERF_SEL_DCACHE_GATCL1_ATCL2_INFLIGHT: The sum of DCACHE inflight ATCL1_ATCL2 requests per cycle " = 0x10c, 
                            "SQC_PERF_SEL_DCACHE_GATCL1_STALL_MISSFIFO_FULL: Total DCACHE gatcl1 stalls due to full miss fifo " = 0x10d, 
                            "SQC_PERF_SEL_DCACHE_GATCL1_STALL_MULTI_MISS: Total DCACHE gatcl1 stalls due to arbitrated multiple misses " = 0x10e, 
                            "SQC_PERF_SEL_DCACHE_GATCL1_HIT_FIFO_FULL: Total DCACHE gatcl1 hit fifo full cycles " = 0x10f, 
                            "SQC_PERF_SEL_ICACHE_PREFETCH_1: Number of +1 prefetch requests granted. (per-SQ) " = 0x110, 
                            "SQC_PERF_SEL_ICACHE_PREFETCH_2: Number of +2 prefetch requests granted. (per-SQ) " = 0x111, 
                            "SQC_PERF_SEL_ICACHE_PREFETCH_FILTERED: Number of prefetch requests filtered out. (per-SQ) " = 0x112, 
                            "SQC_PERF_SEL_DUMMY_LAST: Just a placeholding enum to indicate the last SQC performance counter. Not a real performance counter. " = 0x113, 
                            "SQ_PERF_SEL_INSTS_SMEM_NORM: Number of SMEM instructions issued normalized to match smem_level (*2 load/store; *2 atomic; *2 memtime; *4 wb/inv). (per-simd, emulated) " = 0x114, 
                            "SQ_PERF_SEL_ATC_INSTS_VMEM: Number of VMEM instructions issued to HSA space. (including FLAT) (per-simd, emulated) " = 0x115, 
                            "SQ_PERF_SEL_ATC_INST_LEVEL_VMEM: Number of outstanding xnacks from TA. Set next counter to ACCUM_PREV and divide by SQ_PERF_SEL_ATC_INSTS_VMEM for average latency.  (per-simd, level, nondeterministic) " = 0x116, 
                            "SQ_PERF_SEL_ATC_XNACK_FIRST: Number of first xnack from TA. (per-simd, emulated) " = 0x117, 
                            "SQ_PERF_SEL_ATC_XNACK_ALL: Number of all xnack from TA. (per-simd) " = 0x118, 
                            "SQ_PERF_SEL_ATC_XNACK_FIFO_FULL: Number of cycles XNACK fifo is full. (per-simd, unwindowed) " = 0x119, 
                            "SQ_PERF_SEL_ATC_INSTS_SMEM: Number of SMEM instructions issued to HSA space. (per-simd, emulated) " = 0x11a, 
                            "SQ_PERF_SEL_ATC_INST_LEVEL_SMEM: Number of outstanding xnacks from SQC for waves with HSA address mode * 2. Set next counter to ACCUM_PREV and divide by SQ_PERF_SEL_ATC_INSTS_SMEM*2 for average smem xack/xnack latency. Falls slightly short of total request latency because some fetches are divided into two requests that may finish at different times and this counter collects the average latency of the two. (per-simd, level, nondeterministic) " = 0x11b, 
                            "SQ_PERF_SEL_IFETCH_XNACK: Number of instruction fetch xnack from SQC. (per-simd) " = 0x11c, 
                            "SQ_PERF_SEL_TLB_SHOOTDOWN: Number of TLB shootdowns. (unwindowed, emulated, global) " = 0x11d, 
                            "SQ_PERF_SEL_TLB_SHOOTDOWN_CYCLES: Number of cycles in which a TLB shootdown is active. (unwindowed, global) " = 0x11e, 
                            "SQ_PERF_SEL_INSTS_VMEM_WR_REPLAY: Number of VMEM write instructions replayed (including FLAT). (excluding instructions issued). (per-simd, emulated, nondeterministic) " = 0x11f, 
                            "SQ_PERF_SEL_INSTS_VMEM_RD_REPLAY: Number of VMEM read instructions replayed (including FLAT). (excluding instructions issued). (per-simd, emulated, nondeterministic) " = 0x120, 
                            "SQ_PERF_SEL_INSTS_VMEM_REPLAY: Number of VMEM instructions replayed. (excluding instructions issued). (per-simd, emulated, nondeterministicd) " = 0x121, 
                            "SQ_PERF_SEL_INSTS_SMEM_REPLAY: Number of SMEM instructions replayed. (excluding instructions issued). (per-simd, emulated, nondeterministic) " = 0x122, 
                            "SQ_PERF_SEL_INSTS_SMEM_NORM_REPLAY: Number of SMEM instructions replayed normalized to match smem_level (*2 load/store; *2 atomic; *2 memtime; *4 wb/inv). (excluding instructions issued). (per-simd, emulated, nondeterministic) " = 0x123, 
                            "SQ_PERF_SEL_INSTS_FLAT_REPLAY: Number of FLAT instructions replayed. (excluding instructions issued). (per-simd, emulated, nondeterministic) " = 0x124, 
                            "SQ_PERF_SEL_ATC_INSTS_VMEM_REPLAY: Number of VMEM instructions replayed to HSA space. (including FLAT) (excluding instructions issued). (per-simd, emulated, nondeterministic) " = 0x125, 
                            "SQ_PERF_SEL_ATC_INSTS_SMEM_REPLAY: Number of SMEM instructions issued to HSA space. (excluding instructions issued). (per-simd, emulated, nondeterministic) " = 0x126, 
                            "SQ_PERF_SEL_DUMMY_LAST1: Just a placeholding enum to indicate the last extra SQ performance counter. Not a real performance counter. " = 0x127 }  ;
    SQC_BANK_MASK  15:12  NUM ;
    SQC_CLIENT_MASK  19:16  NUM ;
    SPM_MODE  23:20  ALPHA {"PERFMON_SPM_MODE_OFF: Disable streaming performance counters. " = 0x0, 
                            "PERFMON_SPM_MODE_16BIT_CLAMP: 16 bit streaming mode with clamp and reset " = 0x1, 
                            "PERFMON_SPM_MODE_16BIT_NO_CLAMP: 16 bit streaming mode with No clamp and No reset. " = 0x2, 
                            "PERFMON_SPM_MODE_32BIT_CLAMP: 32 bit streaming mode with clamp and reset " = 0x3, 
                            "PERFMON_SPM_MODE_32BIT_NO_CLAMP: 32 bit streaming mode with No clamp and No reset. " = 0x4, 
                            "PERFMON_SPM_MODE_RESERVED_5: Reserved spm mode. " = 0x5, 
                            "PERFMON_SPM_MODE_RESERVED_6: Reserved spm mode. " = 0x6, 
                            "PERFMON_SPM_MODE_RESERVED_7: Reserved spm mode. " = 0x7, 
                            "PERFMON_SPM_MODE_TEST_MODE_0: Spm test mode 0. " = 0x8, 
                            "PERFMON_SPM_MODE_TEST_MODE_1: Spm test mode 1. " = 0x9, 
                            "PERFMON_SPM_MODE_TEST_MODE_2: Spm test mode 2. " = 0xa }  ;
    SIMD_MASK  27:24  NUM ;
    PERF_MODE  31:28  ALPHA {"PERFMON_COUNTER_MODE_ACCUM: Accumulate increment values over enabled cycles. " = 0x0, 
                            "PERFMON_COUNTER_MODE_ACTIVE_CYCLES: Count the number of cycles with a nonzero increment value. " = 0x1, 
                            "PERFMON_COUNTER_MODE_MAX: Store the largest increment value received over cycles counted. " = 0x2, 
                            "PERFMON_COUNTER_MODE_DIRTY: Record whether a nonzero increment value was ever received. " = 0x3, 
                            "PERFMON_COUNTER_MODE_SAMPLE: Just record the latest increment vlaue. " = 0x4, 
                            "PERFMON_COUNTER_MODE_CYCLES_SINCE_FIRST_EVENT: Count the cycles since a nonzero increment value. " = 0x5, 
                            "PERFMON_COUNTER_MODE_CYCLES_SINCE_LAST_EVENT: Count the cycles since a zero increment value. " = 0x6, 
                            "PERFMON_COUNTER_MODE_CYCLES_GE_HI: Count the cycles with an increment greater than or equal to the value in the high bits. " = 0x7, 
                            "PERFMON_COUNTER_MODE_CYCLES_EQ_HI: Count the cycles with an increment equal to the value in the high bits. " = 0x8, 
                            "PERFMON_COUNTER_MODE_INACTIVE_CYCLES: Count the number of cycles with a zero increment value. " = 0x9, 
                            "PERFMON_COUNTER_MODE_RESERVED: This is here just so this is a 4 bit field in case we add modes in the future.  Don't use it. " = 0xf }  ;
};

SQ_PERFCOUNTER11_SELECT   <GpuF0Reg:0x3672c> <GpuF0VF0Reg:0x3672c> <GpuF0VF1Reg:0x3672c> <GpuF0VF2Reg:0x3672c> <GpuF0VF3Reg:0x3672c> <GpuF0VF4Reg:0x3672c> <GpuF0VF5Reg:0x3672c> <GpuF0VF6Reg:0x3672c> <GpuF0VF7Reg:0x3672c> <GpuF0VF8Reg:0x3672c> <GpuF0VF9Reg:0x3672c> <GpuF0VF10Reg:0x3672c> <GpuF0VF11Reg:0x3672c> <GpuF0VF12Reg:0x3672c> <GpuF0VF13Reg:0x3672c> <GpuF0VF14Reg:0x3672c> <GpuF0VF15Reg:0x3672c> <GpuF1Reg:0x3672c>   32    {
    PERF_SEL  8:0  ALPHA {"SQ_PERF_SEL_NONE: Don't count anything. " = 0x0, 
                            "SQ_PERF_SEL_ACCUM_PREV: For counter N, increment by the value of counter N-1.  Only accumulates once every 4 cycles. " = 0x1, 
                            "SQ_PERF_SEL_CYCLES: Clock cycles. (nondeterministic, per-simd, global) " = 0x2, 
                            "SQ_PERF_SEL_BUSY_CYCLES: Clock cycles while SQ is reporting that it is busy.  (nondeterministic, per-simd, global) " = 0x3, 
                            "SQ_PERF_SEL_WAVES: Count number of waves sent to SQs. (per-simd, emulated, global) " = 0x4, 
                            "SQ_PERF_SEL_LEVEL_WAVES: Track the number of waves.  Set ACCUM_PREV for the next counter to use this. (level, per-simd, global) " = 0x5, 
                            "SQ_PERF_SEL_WAVES_EQ_64: Count number of waves with exactly 64 active threads sent to SQs. (per-simd, emulated, global) " = 0x6, 
                            "SQ_PERF_SEL_WAVES_LT_64: Count number of waves with <64 active threads sent to SQs. (per-simd, emulated, global) " = 0x7, 
                            "SQ_PERF_SEL_WAVES_LT_48: Count number of waves with <48 active threads sent to SQs. (per-simd, emulated, global) " = 0x8, 
                            "SQ_PERF_SEL_WAVES_LT_32: Count number of waves sent <32 active threads sent to SQs. (per-simd, emulated, global) " = 0x9, 
                            "SQ_PERF_SEL_WAVES_LT_16: Count number of waves sent <16 active threads sent to SQs. (per-simd, emulated, global) " = 0xa, 
                            "SQ_PERF_SEL_WAVES_CU: Count number of waves sent to CUs. (per-simd, emulated) " = 0xb, 
                            "SQ_PERF_SEL_LEVEL_WAVES_CU: Track the number of waves.  Set ACCUM_PREV for the next counter to use this. (level, per-simd) " = 0xc, 
                            "SQ_PERF_SEL_BUSY_CU_CYCLES: Count quad-cycles each CU is busy. (nondeterministic, per-simd) " = 0xd, 
                            "SQ_PERF_SEL_ITEMS: Number of valid items per wave.  (per-simd, global) " = 0xe, 
                            "SQ_PERF_SEL_QUADS: Number of completely or partially covered quads per wave.  (per-simd, emulated, global) " = 0xf, 
                            "SQ_PERF_SEL_EVENTS: Number of events.  (unwindowed, emulated, global) " = 0x10, 
                            "SQ_PERF_SEL_SURF_SYNCS: Number of surface syncs.  (unwindowed, emulated, global) " = 0x11, 
                            "SQ_PERF_SEL_TTRACE_REQS: Number of thread trace requests.  (unwindowed, global, nondeterministic) " = 0x12, 
                            "SQ_PERF_SEL_TTRACE_INFLIGHT_REQS: Number of in-flight thread trace requests.  (nondeterministic, unwindowed, global) " = 0x13, 
                            "SQ_PERF_SEL_TTRACE_STALL: Number of cycles thread trace stalls stalled execution.  (nondeterministic, unwindowed, global) " = 0x14, 
                            "SQ_PERF_SEL_MSG_CNTR: Number of counter messages.  (nondeterministic, unwindowed, global) " = 0x15, 
                            "SQ_PERF_SEL_MSG_PERF: Number of perfcounter messages.  (nondeterministic, unwindowed), global " = 0x16, 
                            "SQ_PERF_SEL_MSG_GSCNT: Number of geometry messages.  (emulated, unwindowed, global) " = 0x17, 
                            "SQ_PERF_SEL_MSG_INTERRUPT: Number of interrupt messages.  (emulated, unwindowed, global) " = 0x18, 
                            "SQ_PERF_SEL_INSTS: Number of instructions issued. (per-simd, emulated) " = 0x19, 
                            "SQ_PERF_SEL_INSTS_VALU: Number of VALU instructions issued. (per-simd, emulated) " = 0x1a, 
                            "SQ_PERF_SEL_INSTS_VMEM_WR: Number of VMEM write instructions issued (including FLAT). (per-simd, emulated) " = 0x1b, 
                            "SQ_PERF_SEL_INSTS_VMEM_RD: Number of VMEM read instructions issued (including FLAT). (per-simd, emulated) " = 0x1c, 
                            "SQ_PERF_SEL_INSTS_VMEM: Number of VMEM instructions issued. (per-simd, emulated) " = 0x1d, 
                            "SQ_PERF_SEL_INSTS_SALU: Number of SALU instructions issued. (per-simd, emulated) " = 0x1e, 
                            "SQ_PERF_SEL_INSTS_SMEM: Number of SMEM instructions issued. (per-simd, emulated) " = 0x1f, 
                            "SQ_PERF_SEL_INSTS_FLAT: Number of FLAT instructions issued. (per-simd, emulated) " = 0x20, 
                            "SQ_PERF_SEL_INSTS_FLAT_LDS_ONLY: Number of FLAT instructions issued that read/wrote only from/to LDS (only works if EARLY_TA_DONE is enabled). (per-simd, emulated) " = 0x21, 
                            "SQ_PERF_SEL_INSTS_LDS: Number of LDS instructions issued (including FLAT). (per-simd, emulated) " = 0x22, 
                            "SQ_PERF_SEL_INSTS_GDS: Number of GDS instructions issued. (per-simd, emulated) " = 0x23, 
                            "SQ_PERF_SEL_INSTS_EXP: Number of EXP instructions issued, excluding skipped export instructions. (per-simd, emulated) " = 0x24, 
                            "SQ_PERF_SEL_INSTS_EXP_GDS: Number of EXP and GDS instructions issued, excluding skipped export instructions. (per-simd, emulated) " = 0x25, 
                            "SQ_PERF_SEL_INSTS_BRANCH: Number of Branch instructions issued. (per-simd, emulated) " = 0x26, 
                            "SQ_PERF_SEL_INSTS_SENDMSG: Number of Sendmsg instructions issued. (per-simd, emulated) " = 0x27, 
                            "SQ_PERF_SEL_INSTS_VSKIPPED: Number of vector instructions skipped. (per-simd, emulated) " = 0x28, 
                            "SQ_PERF_SEL_INST_LEVEL_VMEM: Number of in-flight VMEM instructions. Set next counter to ACCUM_PREV and divide by INSTS_VMEM for average latency.  Includes FLAT instructions. (per-simd, level, nondeterministic) " = 0x29, 
                            "SQ_PERF_SEL_INST_LEVEL_SMEM: Number of in-flight SMEM instructions (*2 load/store; *2 atomic; *2 memtime; *4 wb/inv). Set next counter to ACCUM_PREV and divide by INSTS_SMEM for average latency per smem request.  Falls slightly short of total request latency because some fetches are divided into two requests that may finish at different times and this counter collects the average latency of the two. (per-simd, level, nondeterministic) " = 0x2a, 
                            "SQ_PERF_SEL_INST_LEVEL_LDS: Number of in-flight LDS instructions. Set next counter to ACCUM_PREV and divide by INSTS_LDS for average latency. Includes FLAT instructions.  (per-simd, level, nondeterministic) " = 0x2b, 
                            "SQ_PERF_SEL_INST_LEVEL_GDS: Number of in-flight GDS instructions. Set next counter to ACCUM_PREV and divide by INSTS_GDS for average latency. (per-simd, level, nondeterministic) " = 0x2c, 
                            "SQ_PERF_SEL_INST_LEVEL_EXP: Number of in-flight EXP instructions. Set next counter to ACCUM_PREV and divide by INSTS_EXP for average latency. (per-simd, level, nondeterministic) " = 0x2d, 
                            "SQ_PERF_SEL_WAVE_CYCLES: Number of wave-cycles spent by waves in the CUs (per-simd, nondeterministic) " = 0x2e, 
                            "SQ_PERF_SEL_WAVE_READY: Number of wave-cycles waves were ready to execute the next instruction (per-simd, nondeterministic) " = 0x2f, 
                            "SQ_PERF_SEL_WAIT_CNT_VM: Number of wave-cycles spent waiting for VM counter. In units of 4 cycles.  (per-simd, nondeterministic) " = 0x30, 
                            "SQ_PERF_SEL_WAIT_CNT_LGKM: Number of wave-cycles spent waiting for LGKM counter. In units of 4 cycles.  (per-simd, nondeterministic) " = 0x31, 
                            "SQ_PERF_SEL_WAIT_CNT_EXP: Number of wave-cycles spent waiting for EXP counter. In units of 4 cycles.  (per-simd, nondeterministic) " = 0x32, 
                            "SQ_PERF_SEL_WAIT_CNT_ANY: Number of wave-cycles spent waiting for any counter. In units of 4 cycles.  (per-simd, nondeterministic) " = 0x33, 
                            "SQ_PERF_SEL_WAIT_BARRIER: Number of wave-cycles spent waiting for a barrier. In units of 4 cycles.  (per-simd, nondeterministic) " = 0x34, 
                            "SQ_PERF_SEL_WAIT_EXP_ALLOC: Number of wave-cycles spent waiting for export allocation (per-simd, nondeterministic) " = 0x35, 
                            "SQ_PERF_SEL_WAIT_SLEEP: Number of wave-cycles spent waiting for sleep to finish (per-simd, nondeterministic) " = 0x36, 
                            "SQ_PERF_SEL_WAIT_OTHER: Number of wave-cycles spent waiting for dependency stalls (per-simd, nondeterministic) " = 0x37, 
                            "SQ_PERF_SEL_WAIT_ANY: Number of wave-cycles spent waiting for anything (per-simd, nondeterministic) " = 0x38, 
                            "SQ_PERF_SEL_WAIT_TTRACE: Number of wave-cycles spent waiting for thread trace stalls (per-simd, nondeterministic) " = 0x39, 
                            "SQ_PERF_SEL_WAIT_IFETCH: Number of wave-cycles spent waiting for instructions to arrive (per-simd, nondeterministic) " = 0x3a, 
                            "SQ_PERF_SEL_WAIT_INST_VMEM: Number of wave-cycles spent waiting for VMEM instruction issue. In units of 4 cycles.  (per-simd, nondeterministic) " = 0x3b, 
                            "SQ_PERF_SEL_WAIT_INST_SCA: Number of wave-cycles spent waiting for SALU or SMEM instruction issue. In units of 4 cycles. (per-simd, nondeterministic) " = 0x3c, 
                            "SQ_PERF_SEL_WAIT_INST_LDS: Number of wave-cycles spent waiting for LDS instruction issue. In units of 4 cycles. (per-simd, nondeterministic) " = 0x3d, 
                            "SQ_PERF_SEL_WAIT_INST_VALU: Number of wave-cycles spent waiting for VALU instrution issue. In units of 4 cycles. (per-simd, nondeterministic) " = 0x3e, 
                            "SQ_PERF_SEL_WAIT_INST_EXP_GDS: Number of wave-cycles spent waiting for EXPORT or GDS instruction issue. In units of 4 cycles. (per-simd, nondeterministic) " = 0x3f, 
                            "SQ_PERF_SEL_WAIT_INST_MISC: Number of wave-cycles spent waiting for BRANCH or SENDMSG instruction issue. In units of 4 cycles. (per-simd, nondeterministic) " = 0x40, 
                            "SQ_PERF_SEL_WAIT_INST_FLAT: Number of wave-cycles spent waiting for flat instruction issue. In units of 4 cycles. (per-simd, nondeterministic) " = 0x41, 
                            "SQ_PERF_SEL_ACTIVE_INST_ANY: Number of cycles each wave is working on an instruction. (per-simd, nondeterministic) " = 0x42, 
                            "SQ_PERF_SEL_ACTIVE_INST_VMEM: Number of cycles the SQ instruction arbiter is working on a VMEM instruction. (per-simd, nondeterministic) " = 0x43, 
                            "SQ_PERF_SEL_ACTIVE_INST_LDS: Number of cycles the SQ instruction arbiter is working on a LDS instruction. (per-simd, nondeterministic) " = 0x44, 
                            "SQ_PERF_SEL_ACTIVE_INST_VALU: Number of cycles the SQ instruction arbiter is working on a VALU instruction. (per-simd, nondeterministic) " = 0x45, 
                            "SQ_PERF_SEL_ACTIVE_INST_SCA: Number of cycles the SQ instruction arbiter is working on a SALU or SMEM instruction. (per-simd, nondeterministic) " = 0x46, 
                            "SQ_PERF_SEL_ACTIVE_INST_EXP_GDS: Number of cycles the SQ instruction arbiter is working on an EXPORT or GDS instruction. (per-simd, nondeterministic) " = 0x47, 
                            "SQ_PERF_SEL_ACTIVE_INST_MISC: Number of cycles the SQ instruction aribter is working on a BRANCH or SENDMSG instruction. (per-simd, nondeterministic) " = 0x48, 
                            "SQ_PERF_SEL_ACTIVE_INST_FLAT: Number of cycles the SQ instruction arbiter is working on a FLAT instruction. (per-simd, nondeterministic) " = 0x49, 
                            "SQ_PERF_SEL_INST_CYCLES_VMEM_WR: Number of cycles needed to send addr and cmd data for VMEM write instructions. (per-simd, emulated) " = 0x4a, 
                            "SQ_PERF_SEL_INST_CYCLES_VMEM_RD: Number of cycles needed to send addr and cmd data for VMEM read instructions. (per-simd, emulated) " = 0x4b, 
                            "SQ_PERF_SEL_INST_CYCLES_VMEM_ADDR: Number of cycles needed to send VMEM read/write addresses to TA. (per-simd, emulated) " = 0x4c, 
                            "SQ_PERF_SEL_INST_CYCLES_VMEM_DATA: Number of cycles needed to send VMEM write data to TA. (per-simd, emulated) " = 0x4d, 
                            "SQ_PERF_SEL_INST_CYCLES_VMEM_CMD: Number of cycles needed to send VMEM command to TA. (per-simd, emulated) " = 0x4e, 
                            "SQ_PERF_SEL_INST_CYCLES_VMEM: Number of cycles needed to send addr and cmd data for VMEM instructions. (per-simd, emulated) " = 0x4f, 
                            "SQ_PERF_SEL_INST_CYCLES_LDS: Number of cycles needed to send instructions to LDS. (per-simd, emulated) " = 0x50, 
                            "SQ_PERF_SEL_INST_CYCLES_VALU: Number of cycles needed to execute VALU instructions. (per-simd, emulated) " = 0x51, 
                            "SQ_PERF_SEL_INST_CYCLES_EXP: Number of cycles needed to export data for EXP instructions. (per-simd, emulated) " = 0x52, 
                            "SQ_PERF_SEL_INST_CYCLES_GDS: Number of cycles needed to export data for GDS instructions. (per-simd, emulated) " = 0x53, 
                            "SQ_PERF_SEL_INST_CYCLES_SCA: Number of cycles needed to execute scalar instructions. (per-simd, emulated) " = 0x54, 
                            "SQ_PERF_SEL_INST_CYCLES_SMEM: Number of cycles needed to execute scalar memory reads. (per-simd, emulated) " = 0x55, 
                            "SQ_PERF_SEL_INST_CYCLES_SALU: Number of cycles needed to execute non-memory read scalar operations. (per-simd, emulated) " = 0x56, 
                            "SQ_PERF_SEL_INST_CYCLES_EXP_GDS: Number of cycles needed to export data for both EXP or GDS instructions (same as than INST_CYCLES_EXP + INST_CYCLES_GDS). (per-simd, emulated) " = 0x57, 
                            "SQ_PERF_SEL_INST_CYCLES_MISC: Number of cycles needed to execute BRANCH or SENDMSG instructions. (per-simd, emulated) " = 0x58, 
                            "SQ_PERF_SEL_THREAD_CYCLES_VALU: Number of thread-cycles used to execute VALU operations (similar to INST_CYCLES_VALU but multiplied by # of active threads). (per-simd) " = 0x59, 
                            "SQ_PERF_SEL_THREAD_CYCLES_VALU_MAX: Maximum number of thread-cycles VALU operations that could have been executed given the instruction mix (similar to INST_CYCLES_VALU but multiplied by # of active threads). (per-simd, emulated) " = 0x5a, 
                            "SQ_PERF_SEL_IFETCH: Number of instruction fetch requests from cache. (per-simd, emulated) " = 0x5b, 
                            "SQ_PERF_SEL_IFETCH_LEVEL: Number of instruction fetch requests from cache. (per-simd, level) " = 0x5c, 
                            "SQ_PERF_SEL_CBRANCH_FORK: Number of conditional branch instructions. (per-simd, emulated) " = 0x5d, 
                            "SQ_PERF_SEL_CBRANCH_FORK_SPLIT: Number of conditional branch instructions that take both branches. (per-simd, emulated) " = 0x5e, 
                            "SQ_PERF_SEL_VALU_LDS_DIRECT_RD: Number of LDS direct reads issued (excluding interpolation ops). (per-simd, emulated) " = 0x5f, 
                            "SQ_PERF_SEL_VALU_LDS_INTERP_OP: Number of LDS interpolation ops issued. (per-simd, emulated) " = 0x60, 
                            "SQ_PERF_SEL_LDS_BANK_CONFLICT: Number of cycles LDS is stalled by bank conflicts. (emulated) " = 0x61, 
