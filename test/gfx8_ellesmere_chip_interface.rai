 byte permute(byte in[8], byte sel) {
 	if(sel>=13) then return 0xff;
 	elsif(sel==12) then return 0x00;
 	elsif(sel==11) then return in[7][7] * 0xff;
 	elsif(sel==10) then return in[5][7] * 0xff;
 	elsif(sel==9) then return in[3][7] * 0xff;
