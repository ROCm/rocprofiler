SECTION_START CHIP_INFO

CHIP_NAME = "ellesmere";
DESCRIPTION = "R8xx GPU Chip";
RELEASE = "Chip Spec 0.28";
// Edit Vendor ID Here: Default(0xFFFF) means search for all
ASIC_VENDOR_ID = 0x1002;
// Add All Posible Device ID Here
ASIC_DEVICE_ID = 0x524b;
// ASIC_DEVICE_ID = ;

SECTION_END

// === ASIC ADDRESS SPACE DEFINITIONS ===
SECTION_START CHIP_SPACES

