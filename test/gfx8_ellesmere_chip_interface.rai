    NONSURF_ARRAY_MODE  4:1  ALPHA {"ARRAY_LINEAR_GENERAL: Unaligned linear array " = 0x0, 
                            "ARRAY_LINEAR_ALIGNED: Aligned linear array " = 0x1, 
                            "ARRAY_1D_TILED_THIN1: Uses 1D 8x8x1 tiles. Not valid for AA modes. " = 0x2, 
                            "ARRAY_1D_TILED_THICK: Uses 1D 8x8x4 tiles. Not valid for AA modes. " = 0x3, 
                            "ARRAY_2D_TILED_THIN1: Uses 8x8x1 macro-tiles " = 0x4, 
                            "ARRAY_PRT_TILED_THIN1: new in bxx " = 0x5, 
                            "ARRAY_PRT_2D_TILED_THIN1: new in bxx " = 0x6, 
                            "ARRAY_2D_TILED_THICK: Uses 8x8x4 macro-tiles " = 0x7, 
                            "ARRAY_2D_TILED_XTHICK: ADDED in 9xx " = 0x8, 
                            "ARRAY_PRT_TILED_THICK: new in bxx " = 0x9, 
                            "ARRAY_PRT_2D_TILED_THICK: new in bxx " = 0xa, 
                            "ARRAY_PRT_3D_TILED_THIN1: new in bxx " = 0xb, 
                            "ARRAY_3D_TILED_THIN1: Slices are pipe rotated " = 0xc, 
                            "ARRAY_3D_TILED_THICK: Slices are pipe rotated " = 0xd, 
                            "ARRAY_3D_TILED_XTHICK: ADDED in 9xx " = 0xe, 
                            "ARRAY_PRT_3D_TILED_THICK: new in bxx " = 0xf }  ;
    NONSURF_ENDIAN  6:5  ALPHA {"ENDIAN_NONE: No endian swapping (XOR by 0) " = 0x0, 
                            "ENDIAN_8IN16: 8 bit swap within 16 bit word 
	(XOR by 1): 0xAABBCCDD -> 0xBBAADDCC " = 0x1, 
                            "ENDIAN_8IN32: 8 bit swap within 32 bit word 
	(XOR by 3): 0xAABBCCDD -> 0xDDCCBBAA " = 0x2, 
