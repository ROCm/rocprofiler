    ENABLE  0:0  ALPHA {"disable client " = 0x0, 
                            "enable client " = 0x1 }  ;
    PRESCALE  2:1  ALPHA {"urgency is not changed " = 0x0, 
                            "urgency is prescaled by 1/2 " = 0x1, 
                            "urgency is prescaled by 2 " = 0x2, 
                            "urgency is prescaled by 0, wt is 0. " = 0x3 }  ;
    BLACKOUT_EXEMPT  3:3  ALPHA {"not exempt from blackout " = 0x0, 
                            "exempt from blackout, can still make memory requests " = 0x1 }  ;
    STALL_MODE  5:4  ALPHA {"ignore stall signal " = 0x0, 
                            "double arbitration weight when stall is asserted " = 0x1, 
                            "quadruple arbitration weight when stall is asserted " = 0x2, 
                            "maximum value to arbitration weight when stall is asserted; only for use by display " = 0x3 }  ;
    STALL_OVERRIDE  6:6  ALPHA {"no override of stall signal " = 0x0, 
                            "when set, stall signal is set to the or of the bits in STALL_MODE register " = 0x1 }  ;
