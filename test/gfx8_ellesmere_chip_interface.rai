                            "SQ_PERF_SEL_POWER_TEX_BUSY: Number of CAC pulses for cycles texture clocks are active (nondeterministic, unwindowed) " = 0xa2, 
                            "SQ_PERF_SEL_ACCUM_PREV_HIRES: For counter N, increment by the value of counter N-1. " = 0xa3, 
                            "SQ_PERF_SEL_WAVES_RESTORED: Count number of context-restored waves sent to SQs. (per-simd, emulated, global) " = 0xa4, 
                            "SQ_PERF_SEL_WAVES_SAVED: Count number of context-saved waves. (per-simd, emulated, global) " = 0xa5, 
                            "SQ_PERF_SEL_DUMMY_LAST: Just a placeholding enum to separate SQ from SQC counters. Not a real performance counter. " = 0xa7, 
                            "SQC_PERF_SEL_ICACHE_INPUT_VALID_READY: Successful Transaction (per-SQ, nondeterministic, unwindowed) " = 0xa8, 
                            "SQC_PERF_SEL_ICACHE_INPUT_VALID_READYB: Input stalled by SQC (per-SQ, nondeterministic, unwindowed) " = 0xa9, 
                            "SQC_PERF_SEL_ICACHE_INPUT_VALIDB: SQC starved (per-SQ, nondeterministic, unwindowed) " = 0xaa, 
                            "SQC_PERF_SEL_DCACHE_INPUT_VALID_READY: Successful Transaction (per-SQ, nondeterministic, unwindowed) " = 0xab, 
