                            "SQC_PERF_SEL_ICACHE_GATCL1_PERMISSION_MISS: Total ICACHE gatcl1 permission misses " = 0xfb, 
                            "SQC_PERF_SEL_ICACHE_GATCL1_REQUEST: Total ICACHE CLIENT_ATCL1 NORMAL requestes " = 0xfc, 
