                            "SQC_PERF_SEL_DCACHE_CACHE_STALL_OUTPUT: Number of cycles stalled at cache controller output.  (per-Bank, nondeterministic, unwindowed) " = 0xdd, 
                            "SQC_PERF_SEL_DCACHE_CACHE_STALL_EVICT: Number of cycles stalled trying to do an evict.  (per-Bank, nondeterministic, unwindowed) " = 0xde, 
