                            "TCC_PERF_SEL_TC_OP_WBL2_NC_CYCLE  :  Number of cycles spent performing TC_OP_WBL2_NC requests. " = 0x58, 
                            "TCC_PERF_SEL_TC_OP_INVL2_NC_CYCLE  :  Number of cycles spent performing TC_OP_INVL2_NC requests. " = 0x59, 
