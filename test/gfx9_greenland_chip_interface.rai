                            "TCC_PERF_SEL_CLIENT111_REQ" = 0xef, 
                            "TCC_PERF_SEL_CLIENT112_REQ" = 0xf0, 
                            "TCC_PERF_SEL_CLIENT113_REQ" = 0xf1, 
                            "TCC_PERF_SEL_CLIENT114_REQ" = 0xf2, 
                            "TCC_PERF_SEL_CLIENT115_REQ" = 0xf3, 
                            "TCC_PERF_SEL_CLIENT116_REQ" = 0xf4, 
