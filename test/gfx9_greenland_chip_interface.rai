RMI_PERFCOUNTER3_SELECT   <GpuF0Reg:0x37414> <GpuF1Reg:0x37414>   32    {
    PERF_SEL  8:0  ALPHA {"RMI_PERF_SEL_NONE  :  Count nothing " = 0x0, 
                            "RMI_PERF_SEL_BUSY  :  Number of busy cycles " = 0x1, 
                            "RMI_PERF_SEL_REG_CLK_VLD  :  Number of cycles that the registre clock is enabled. " = 0x2, 
                            "RMI_PERF_SEL_DYN_CLK_CMN_VLD  :  Number of cycles that the common core clock is enabled. " = 0x3, 
                            "RMI_PERF_SEL_DYN_CLK_RB_VLD  :  Number of cycles that the RB0 clock is enabled.  " = 0x4, 
                            "RMI_PERF_SEL_DYN_CLK_PERF_VLD  :  Number of cycles that the perf clock is enabled.  " = 0x5, 
                            "RMI_PERF_SEL_PERF_WINDOW  :  This is performance window event. Window between perf start and perf end event using perf clk. Can be used as denominator for bandwidth calculation. " = 0x6, 
                            "RMI_PERF_SEL_EVENT_SEND  :  Indicates RMI receiving an event. " = 0x7, 
                            "RMI_PERF_SEL_RMI_INVALIDATION_ATC_REQ_VMID0  :  ATC invalidation event (rising edge of start) to RMI for VMID0. Can be used to calculate rmi_invalidation_atc_req for VMID0 bandwidth. " = 0x8, 
                            "RMI_PERF_SEL_RMI_INVALIDATION_ATC_REQ_VMID1  :  same as above using VMID1. " = 0x9, 
                            "RMI_PERF_SEL_RMI_INVALIDATION_ATC_REQ_VMID2  :  same as above using VMID2 " = 0xa, 
                            "RMI_PERF_SEL_RMI_INVALIDATION_ATC_REQ_VMID3  :  same as above using VMID3 " = 0xb, 
                            "RMI_PERF_SEL_RMI_INVALIDATION_ATC_REQ_VMID4  :  same as above using VMID4 " = 0xc, 
                            "RMI_PERF_SEL_RMI_INVALIDATION_ATC_REQ_VMID5  :  same as above using VMID5 " = 0xd, 
