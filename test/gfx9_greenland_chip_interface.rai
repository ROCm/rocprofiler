                            "CP_PERFMON_STATE_COUNT_AND_DUMP_PHANTOM  :  Count and Dump out Phantom Counters.  Only useful during simulation. " = 0x5 }  ;
    SPM_PERFMON_STATE  7:4  ALPHA {"STRM_PERFMON_STATE_DISABLE_AND_RESET  :  Disable and Reset Count. " = 0x0, 
                            "STRM_PERFMON_STATE_START_COUNTING  :  Start Counting. " = 0x1, 
                            "STRM_PERFMON_STATE_STOP_COUNTING  :  Freeze - Stop Counting. " = 0x2, 
                            "STRM_PERFMON_STATE_RESERVED_3  :  Reserved for backwards compatibility " = 0x3, 
                            "STRM_PERFMON_STATE_DISABLE_AND_RESET_PHANTOM  :  Disable and Reset Phantom Counters.  Only useful during simulation. " = 0x4, 
                            "STRM_PERFMON_STATE_COUNT_AND_DUMP_PHANTOM  :  Count and Dump out Phantom Counters.  Only useful during simulation. " = 0x5 }  ;
    PERFMON_ENABLE_MODE  9:8  ALPHA {"CP_PERFMON_ENABLE_MODE_ALWAYS_COUNT  :  Always Count. " = 0x0, 
                            "CP_PERFMON_ENABLE_MODE_RESERVED_1  :  Reserved for later use. " = 0x1, 
                            "CP_PERFMON_ENABLE_MODE_COUNT_CONTEXT_TRUE  :  Count events whose contexts are marked for counting by CP_PERFMON_CNTX_CNTL.PERFMON_ENABLE. " = 0x2, 
                            "CP_PERFMON_ENABLE_MODE_COUNT_CONTEXT_FALSE  :  Count events whose contexts are not marked for counting by CP_PERFMON_CNTX_CNTL.PERFMON_ENABLE. " = 0x3 }  ;
    PERFMON_SAMPLE_ENABLE  10:10  ALPHA {"Do nothing. " = 0x0, 
                            "Sample performance counters. " = 0x1 }  W;
};

