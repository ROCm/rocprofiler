TD_PERFCOUNTER0_SELECT   <GpuF0Reg:0x36c00> <GpuF1Reg:0x36c00>   32    {
    PERF_SEL  7:0  ALPHA {"TD_PERF_SEL_none  :  Won't count anything. " = 0x0, 
                            "TD_PERF_SEL_td_busy  :  TD is processing or waiting for data.  Perf_Windowing not supported for this counter. " = 0x1, 
                            "TD_PERF_SEL_input_busy  :  TD input subblock is busy or waiting for data. This means the instruction, state or TC data fifos may not be empty or the TD is processing a wave.  Perf_Windowing not supported for this counter. " = 0x2, 
                            "TD_PERF_SEL_output_busy  :  TD output subblock is busy or waiting for data.  This means the TD's output pipeline (accumulation, data swizzle, data packing) could be processing pixel data.  Perf_Windowing not supported for this counter. " = 0x3, 
                            "TD_PERF_SEL_lerp_busy  :  TD filter block is busy, which means any of the four lerps has pixel data flowing down its pipeline (blend, accumulation, format).  Perf_Windowing not supported for this counter. " = 0x4, 
                            "TD_PERF_SEL_reg_sclk_vld  :  Clock gate enable for GRBM register reads & writes.  Perf_Windowing not supported for this counter. " = 0x5, 
                            "TD_PERF_SEL_local_cg_dyn_sclk_grp0_en  :  Clock gate enable for group0 - non-harvestable always_on domain.  Perf_Windowing not supported for this counter. " = 0x6, 
                            "TD_PERF_SEL_local_cg_dyn_sclk_grp1_en  :  Clock gate enable for group1 - harvestable texture logic domain.  Perf_Windowing not supported for this counter. " = 0x7, 
                            "TD_PERF_SEL_local_cg_dyn_sclk_grp4_en  :  Clock gate enable for group4 - non-harvestable GDS chain domain.  Perf_Windowing not supported for this counter. " = 0x8, 
                            "TD_PERF_SEL_local_cg_dyn_sclk_grp5_en  :  Clock gate enable for group5 - non-harvestable texture boundary domain.  Perf_Windowing not supported for this counter. " = 0x9, 
                            "TD_PERF_SEL_tc_td_fifo_full  :  TC_TD input FIFO is full.  This counter could denote a stall in the TD pipeline, which could come from data cycling in the lerps or power throttling from the SMU. " = 0xa, 
                            "TD_PERF_SEL_output_fifo_full  :  TD output FIFO is full.  This counter could denote a stall in the TD pipeline, possibly due to the GDS or PC/LDS. " = 0xb, 
                            "TD_PERF_SEL_RESERVED_12  :  RESERVED_12 " = 0xc, 
                            "TD_PERF_SEL_RESERVED_13  :  RESERVED_13 " = 0xd, 
                            "TD_PERF_SEL_RESERVED_14  :  RESERVED_14 " = 0xe, 
                            "TD_PERF_SEL_tc_stall  :  TD is stalled waiting for TC data. " = 0xf, 
                            "TD_PERF_SEL_pc_stall  :  TD is stalled by PC waiting to send LDS data. " = 0x10, 
                            "TD_PERF_SEL_gds_stall  :  TD is stalled by GDS data. " = 0x11, 
                            "TD_PERF_SEL_RESERVED_18  :  RESERVED_18 " = 0x12, 
                            "TD_PERF_SEL_RESERVED_19  :  RESERVED_19 " = 0x13, 
                            "TD_PERF_SEL_gather4_wavefront  :  Count the wavefronts with opcode = gather4, includes gather4_c. " = 0x14, 
                            "TD_PERF_SEL_gather4h_wavefront  :  Count the wavefronts with opcode = gather4h. " = 0x15, 
                            "TD_PERF_SEL_gather4h_packed_wavefront  :  Count the wavefronts with opcode = gather4h_packed. " = 0x16, 
                            "TD_PERF_SEL_gather8h_packed_wavefront  :  Count the wavefronts with opcode = gather8h_packed. " = 0x17, 
                            "TD_PERF_SEL_sample_c_wavefront  :  Count the wavefronts with opcode = sample_c, includes gather4_c. " = 0x18, 
                            "TD_PERF_SEL_load_wavefront  :  Count the wavefronts with opcode = load, include atomics and store. " = 0x19, 
                            "TD_PERF_SEL_atomic_wavefront  :  Count the wavefronts with opcode = atomic. " = 0x1a, 
                            "TD_PERF_SEL_store_wavefront  :  Count the wavefronts with opcode = store. " = 0x1b, 
                            "TD_PERF_SEL_ldfptr_wavefront  :  Count the wavefronts with LDFPTR formats. " = 0x1c, 
                            "TD_PERF_SEL_d16_en_wavefront  :  Count the wavefronts that use d16 conversion " = 0x1d, 
                            "TD_PERF_SEL_bypass_filter_wavefront  :  Count the wavefronts that bypass the filter, includes bypass opcode or bypass formats. " = 0x1e, 
                            "TD_PERF_SEL_min_max_filter_wavefront  :  Count the wavefronts that use min/max filtering. " = 0x1f, 
                            "TD_PERF_SEL_coalescable_wavefront  :  Count wavefronts that TA finds coalescable. " = 0x20, 
                            "TD_PERF_SEL_coalesced_phase  :  Count up when each phase is coalesced, if all phases in a wavefront were coalesced the count will be 16. " = 0x21, 
                            "TD_PERF_SEL_four_phase_wavefront  :  dmask=1,2,4,8, wavefront was packed into a 4 phase packet for SP. " = 0x22, 
                            "TD_PERF_SEL_eight_phase_wavefront  :  dmask=3,5,6,9,a,c, wavefront was packed into an 8 phase packet for SP. " = 0x23, 
                            "TD_PERF_SEL_sixteen_phase_wavefront  :  dmask=7,b,d,e,f, wavefront was forwarded to SP in 16 phases. " = 0x24, 
                            "TD_PERF_SEL_four_phase_forward_wavefront  :  Count the wavefronts that were forwarded to SP in 4 phases (coalescable). " = 0x25, 
                            "TD_PERF_SEL_write_ack_wavefront  :  Count write acknowledgments, sent to SQ and not to SP. " = 0x26, 
                            "TD_PERF_SEL_RESERVED_39  :  RESERVED_39 " = 0x27, 
                            "TD_PERF_SEL_user_defined_border  :  Count the wavefronts that user defined border color was used. " = 0x28, 
                            "TD_PERF_SEL_white_border  :  Count the wavefronts that white border color was used. " = 0x29, 
                            "TD_PERF_SEL_opaque_black_border  :  Count the wavefronts that opaque black border color was used. " = 0x2a, 
                            "TD_PERF_SEL_RESERVED_43  :  RESERVED_43 " = 0x2b, 
                            "TD_PERF_SEL_RESERVED_44  :  RESERVED_44 " = 0x2c, 
                            "TD_PERF_SEL_nack  :  Count the number of times an nack packet was generated and sent to SP/SQ. " = 0x2d, 
                            "TD_PERF_SEL_td_sp_traffic  :  Count the number of times this TD sends data to the SP. " = 0x2e, 
                            "TD_PERF_SEL_consume_gds_traffic  :  Count the number of times GDS data was consumed by this TD, send to SP. " = 0x2f, 
                            "TD_PERF_SEL_addresscmd_poison  :  Count the wavefronts that had poisoned address or command. " = 0x30, 
                            "TD_PERF_SEL_data_poison  :  Count the wavefronts that had poisoned data. " = 0x31, 
                            "TD_PERF_SEL_start_cycle_0  :  Count the number of times there was a phase change in a wave and the starting cycle was 0.  Starting cycle denotes how fast the TD can process the incoming sample (0 is fastest, 3 is slowest). " = 0x32, 
                            "TD_PERF_SEL_start_cycle_1  :  Count the number of times there was a phase change in a wave and the starting cycle was 1.  Starting cycle denotes how fast the TD can process the incoming sample (0 is fastest, 3 is slowest). " = 0x33, 
                            "TD_PERF_SEL_start_cycle_2  :  Count the number of times there was a phase change in a wave and the starting cycle was 2.  Starting cycle denotes how fast the TD can process the incoming sample (0 is fastest, 3 is slowest). " = 0x34, 
                            "TD_PERF_SEL_start_cycle_3  :  Count the number of times there was a phase change in a wave and the starting cycle was 3.  Starting cycle denotes how fast the TD can process the incoming sample (0 is fastest, 3 is slowest). " = 0x35, 
                            "TD_PERF_SEL_null_cycle_output  :  Count the number of times that null cycles had occured at the output stage " = 0x36, 
