                            "vgt_perf_waveid_stalled  :  Number of cycles vs waves are stalled waiting for a eop/eopg sync during the draw part of DispatchDraw. " = 0x58, 
                            "vgt_perf_gog_busy  :  Counts number of cycles that the GOG block is busy " = 0x59, 
