                            "TD_PERF_SEL_td_sp_traffic  :  Count the number of times this TD sends data to the SP. " = 0x2e, 
                            "TD_PERF_SEL_consume_gds_traffic  :  Count the number of times GDS data was consumed by this TD, send to SP. " = 0x2f, 
                            "TD_PERF_SEL_addresscmd_poison  :  Count the wavefronts that had poisoned address or command. " = 0x30, 
                            "TD_PERF_SEL_data_poison  :  Count the wavefronts that had poisoned data. " = 0x31, 
                            "TD_PERF_SEL_start_cycle_0  :  Count the number of times there was a phase change in a wave and the starting cycle was 0.  Starting cycle denotes how fast the TD can process the incoming sample (0 is fastest, 3 is slowest). " = 0x32, 
                            "TD_PERF_SEL_start_cycle_1  :  Count the number of times there was a phase change in a wave and the starting cycle was 1.  Starting cycle denotes how fast the TD can process the incoming sample (0 is fastest, 3 is slowest). " = 0x33, 
                            "TD_PERF_SEL_start_cycle_2  :  Count the number of times there was a phase change in a wave and the starting cycle was 2.  Starting cycle denotes how fast the TD can process the incoming sample (0 is fastest, 3 is slowest). " = 0x34, 
                            "TD_PERF_SEL_start_cycle_3  :  Count the number of times there was a phase change in a wave and the starting cycle was 3.  Starting cycle denotes how fast the TD can process the incoming sample (0 is fastest, 3 is slowest). " = 0x35, 
                            "TD_PERF_SEL_null_cycle_output  :  Count the number of times that null cycles had occured at the output stage " = 0x36, 
                            "TD_PERF_SEL_d16_data_packed  :  Count the number of times the TD packs 2 sets of d16 data into 1 32-bit container " = 0x37, 
                            "TD_PERF_SEL_texels_zeroed_out_by_blend_zero_prt  :  Count the number of times a texel was zeroed out due to the blend zero prt feature " = 0x38 }  ;
    CNTR_MODE  23:20  NUM ;
    PERF_MODE1  27:24  ALPHA {"PERFMON_COUNTER_MODE_ACCUM  :  Accumulate increment values over enabled cycles. " = 0x0, 
                            "PERFMON_COUNTER_MODE_ACTIVE_CYCLES  :  Count the number of cycles with a nonzero increment value. " = 0x1, 
                            "PERFMON_COUNTER_MODE_MAX  :  Store the largest increment value received over cycles counted. " = 0x2, 
                            "PERFMON_COUNTER_MODE_DIRTY  :  Record whether a nonzero increment value was ever received. " = 0x3, 
                            "PERFMON_COUNTER_MODE_SAMPLE  :  Just record the latest increment vlaue. " = 0x4, 
                            "PERFMON_COUNTER_MODE_CYCLES_SINCE_FIRST_EVENT  :  Count the cycles since a nonzero increment value. " = 0x5, 
                            "PERFMON_COUNTER_MODE_CYCLES_SINCE_LAST_EVENT  :  Count the cycles since a zero increment value. " = 0x6, 
                            "PERFMON_COUNTER_MODE_CYCLES_GE_HI  :  Count the cycles with an increment greater than or equal to the value in the high bits. " = 0x7, 
                            "PERFMON_COUNTER_MODE_CYCLES_EQ_HI  :  Count the cycles with an increment equal to the value in the high bits. " = 0x8, 
