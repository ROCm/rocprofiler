SQ_WAVE_IB_DBG0   <SQIND:0x1c>   32  R {
    IBUF_ST  2:0  ALPHA {"SQ_IBUF_IB_IDLE  :  ibuf is idle. " = 0x0, 
                            "SQ_IBUF_IB_INI_WAIT_GNT  :  ibuf with new PC and wait for ifech grant. " = 0x1, 
                            "SQ_IBUF_IB_INI_WAIT_DRET  :  ibuf with new PC plus ifetch request has been accepted, and is wait for idata to retrun. " = 0x2, 
                            "SQ_IBUF_IB_LE_4DW  :  ibuf has less then 4dw of idata avilable. " = 0x3, 
                            "SQ_IBUF_IB_WAIT_DRET  :  ibuf has a ifetch request been accepted, and is wait for idata to retrun. " = 0x4, 
                            "SQ_IBUF_IB_EMPTY_WAIT_DRET  :  ibuf is empty and has a ifetch request been accepted, and is wait for idata to retrun. " = 0x5, 
                            "SQ_IBUF_IB_DRET  :  ibuf has more than 4dw of idata avilable. " = 0x6, 
                            "SQ_IBUF_IB_EMPTY_WAIT_GNT  :  ibuf is empty, and has a ifetch request wait for grant. " = 0x7 }  ;
    PC_INVALID  3:3  NUM ;
    NEED_NEXT_DW  4:4  NUM ;
    NO_PREFETCH_CNT  7:5  NUM ;
    IBUF_RPTR  9:8  NUM ;
    IBUF_WPTR  11:10  NUM ;
    INST_STR_ST  19:16  ALPHA {"SQ_INST_STR_IB_WAVE_NORML  :  instr stream in normal state. " = 0x0, 
                            "SQ_INST_STR_IB_WAVE2ID_NORMAL_INST_AV  :  instr stream has a to ID instr. " = 0x1, 
                            "SQ_INST_STR_IB_WAVE_INTERNAL_INST_AV  :  instr stream has a internal instr " = 0x2, 
                            "SQ_INST_STR_IB_WAVE_INST_SKIP_AV  :  instr stream  has a skip instr " = 0x3, 
                            "SQ_INST_STR_IB_WAVE_SETVSKIP_ST0  :  instr stream is in wait vskip state 0 " = 0x4, 
                            "SQ_INST_STR_IB_WAVE_SETVSKIP_ST1  :  instr stream is in wait vskip state 1 " = 0x5, 
                            "SQ_INST_STR_IB_WAVE_NOP_SLEEP_WAIT  :  instr stream wait for nop or sleep to finish " = 0x6, 
