                            "vgt_perf_gs_done_received  :  Counts number of GS DONES received by the VGT " = 0x87, 
                            "vgt_perf_UNUSED136  :  UNUSED " = 0x88, 
                            "vgt_perf_gs_ring_high_water_mark  :  Records maximum number of GS waves outstanding in the GS ring.  Counter select must be set to MAX mode " = 0x89, 
                            "vgt_perf_vs_table_high_water_mark  :  Records maximum number of VS waves outstanding in the VS table.  Counter select must be set to MAX mode " = 0x8a, 
                            "vgt_perf_hs_tgs_active_high_water_mark  :  Records maximum number of active threadgroups.  Counter select must be set to MAX mode " = 0x8b, 
                            "vgt_perf_pa_clipp_dealloc  :  Counts number of CLIPP Dealloc issued by the VGT. " = 0x8c, 
                            "vgt_perf_cut_mem_flush_stalled  :  Counts number of cycles Cut Memory was stalled due to flush. " = 0x8d, 
                            "vgt_perf_vsvert_work_received  :  Counts number of cycles between first vsvert_send to EOP vsvert_send. " = 0x8e, 
                            "vgt_perf_vgt_pa_clipp_starved_after_work  :  Counts number of cycles between non-event clipp_send and stop when clipp_send with eop. " = 0x8f, 
                            "vgt_perf_te11_con_starved_after_work  :  Counts number of cycles te11_con is starved between receiving first patch of a packet and the last. " = 0x90, 
                            "vgt_perf_te11_con_stalled  :  Counts number of cycles te11_con is stalled while wanting to output. " = 0x91, 
                            "vgt_perf_vgt_spi_vsvert_valid  :  Counts the number of valid vsverts " = 0x92, 
                            "vgt_perf_sclk_te11_vld  :  number of clocks the tessellator is active " = 0x93 }  ;
    PERF_MODE3  27:24  ALPHA {"PERFMON_COUNTER_MODE_ACCUM  :  Accumulate increment values over enabled cycles. " = 0x0, 
                            "PERFMON_COUNTER_MODE_ACTIVE_CYCLES  :  Count the number of cycles with a nonzero increment value. " = 0x1, 
                            "PERFMON_COUNTER_MODE_MAX  :  Store the largest increment value received over cycles counted. " = 0x2, 
                            "PERFMON_COUNTER_MODE_DIRTY  :  Record whether a nonzero increment value was ever received. " = 0x3, 
                            "PERFMON_COUNTER_MODE_SAMPLE  :  Just record the latest increment vlaue. " = 0x4, 
                            "PERFMON_COUNTER_MODE_CYCLES_SINCE_FIRST_EVENT  :  Count the cycles since a nonzero increment value. " = 0x5, 
                            "PERFMON_COUNTER_MODE_CYCLES_SINCE_LAST_EVENT  :  Count the cycles since a zero increment value. " = 0x6, 
                            "PERFMON_COUNTER_MODE_CYCLES_GE_HI  :  Count the cycles with an increment greater than or equal to the value in the high bits. " = 0x7, 
                            "PERFMON_COUNTER_MODE_CYCLES_EQ_HI  :  Count the cycles with an increment equal to the value in the high bits. " = 0x8, 
                            "PERFMON_COUNTER_MODE_INACTIVE_CYCLES  :  Count the number of cycles with a zero increment value. " = 0x9, 
                            "PERFMON_COUNTER_MODE_RESERVED  :  This is here just so this is a 4 bit field in case we add modes in the future.  Don't use it. " = 0xf }  ;
    PERF_MODE2  31:28  ALPHA {"PERFMON_COUNTER_MODE_ACCUM  :  Accumulate increment values over enabled cycles. " = 0x0, 
                            "PERFMON_COUNTER_MODE_ACTIVE_CYCLES  :  Count the number of cycles with a nonzero increment value. " = 0x1, 
                            "PERFMON_COUNTER_MODE_MAX  :  Store the largest increment value received over cycles counted. " = 0x2, 
                            "PERFMON_COUNTER_MODE_DIRTY  :  Record whether a nonzero increment value was ever received. " = 0x3, 
                            "PERFMON_COUNTER_MODE_SAMPLE  :  Just record the latest increment vlaue. " = 0x4, 
                            "PERFMON_COUNTER_MODE_CYCLES_SINCE_FIRST_EVENT  :  Count the cycles since a nonzero increment value. " = 0x5, 
                            "PERFMON_COUNTER_MODE_CYCLES_SINCE_LAST_EVENT  :  Count the cycles since a zero increment value. " = 0x6, 
                            "PERFMON_COUNTER_MODE_CYCLES_GE_HI  :  Count the cycles with an increment greater than or equal to the value in the high bits. " = 0x7, 
                            "PERFMON_COUNTER_MODE_CYCLES_EQ_HI  :  Count the cycles with an increment equal to the value in the high bits. " = 0x8, 
                            "PERFMON_COUNTER_MODE_INACTIVE_CYCLES  :  Count the number of cycles with a zero increment value. " = 0x9, 
                            "PERFMON_COUNTER_MODE_RESERVED  :  This is here just so this is a 4 bit field in case we add modes in the future.  Don't use it. " = 0xf }  ;
};

VGT_PERFCOUNTER1_SELECT1   <GpuF0Reg:0x36244> <GpuF1Reg:0x36244>   32    {
    PERF_SEL2  9:0  ALPHA {"vgt_perf_UNUSED0  :  UNUSED " = 0x0, 
                            "vgt_perf_VGT_SPI_ESVERT_VALID  :  number of valid ES verts " = 0x1, 
                            "vgt_perf_VGT_SPI_ESVERT_EOV  :  number of ES end of vectors (eov can count when valid is low). Vector and wavefront are interchangeable terms. " = 0x2, 
                            "vgt_perf_VGT_SPI_ESVERT_STALLED  :  ready to send an ES vert but stalled by the SPI. This counter is only for the legacy path. For NGG use vgt_perf_VGT_SPI_PRIMGEN_ES_VERT_FIFO_STALL " = 0x3, 
                            "vgt_perf_VGT_SPI_ESVERT_STARVED_BUSY  :  ES vert interface is starved while the VGT is busy " = 0x4, 
                            "vgt_perf_VGT_SPI_ESVERT_STARVED_IDLE  :  ES vert interface is starved while the VGT is idle, but clocks are on " = 0x5, 
                            "vgt_perf_VGT_SPI_ESVERT_STATIC  :  ES vert interface is not stalled yet SPI is asserting back pressure " = 0x6, 
                            "vgt_perf_VGT_SPI_PRIMGEN_GS_PRIM_FIFO_STALL  :  Primgen output is stalled because there's no more prim storage in the SPI and VGT " = 0x7, 
                            "vgt_perf_VGT_SPI_PRIMGEN_ES_VERT_FIFO_STALL  :  Primgen output is stalled because there's no more vertex storage in the SPI and VGT " = 0x8, 
                            "vgt_perf_VGT_SPI_GSPRIM_VALID  :  number of valid GS prims " = 0x9, 
                            "vgt_perf_VGT_SPI_GSPRIM_EOV  :  number of GS end of vectors (eov can count when valid is low). Vector and wavefront are interchangeable terms. " = 0xa, 
                            "vgt_perf_VGT_SPI_GSPRIM_CONT  :  GS primitive continued transfers indicate the number of multi-cycle primitives " = 0xb, 
                            "vgt_perf_VGT_SPI_PRIMGEN_SUBGRP_FIFO_STALL  :  Primgen cannot send more subgroup starts to the SPI due to back pressure " = 0xc, 
                            "vgt_perf_VGT_SPI_GSPRIM_STARVED_BUSY  :  GS prim interface is starved while the VGT is busy " = 0xd, 
                            "vgt_perf_VGT_SPI_GSPRIM_STARVED_IDLE  :  GS prim interface is starved while the VGT is idle, but clocks are on " = 0xe, 
                            "vgt_perf_VGT_SPI_GSPRIM_STATIC  :  GS prim interface is not stalled yet SPI is asserting back pressure " = 0xf, 
                            "vgt_perf_VGT_SPI_GSSUBGRP_EVENT_WINDOW_ACTIVE  :  GS event window is active (time between START and STOP events during which GS perf counters are active) " = 0x10, 
                            "vgt_perf_VGT_SPI_GSSUBGRP_IS_EVENT  :  number of event transfers to the SPI over the GS sub-group interface " = 0x11, 
                            "vgt_perf_VGT_SPI_GSSUBGRP_SEND  :  number of GS sub-group transfers to the SPI, including events " = 0x12, 
                            "vgt_perf_VGT_SPI_VSWAVE_EVENT_WINDOW_ACTIVE  :  VS event window is active (time between START and STOP events during which VS perf counters are active) " = 0x13, 
                            "vgt_perf_VGT_SPI_VSVERT_SEND  :  number of VS verts, including null EOV's " = 0x14, 
                            "vgt_perf_VGT_SPI_VSVERT_EOV  :  number of VS end of vector transfers. Vector and wavefront are interchangeable terms. " = 0x15, 
                            "vgt_perf_VGT_SPI_VSVERT_STALLED  :  ready to send a VS vert, but stalled by the SPI " = 0x16, 
                            "vgt_perf_VGT_SPI_VSVERT_STARVED_BUSY  :  VS vert interface is starved while the VGT is busy " = 0x17, 
                            "vgt_perf_VGT_SPI_VSVERT_STARVED_IDLE  :  VS vert interface is starved while the VGT is idle, but clocks are on " = 0x18, 
                            "vgt_perf_VGT_SPI_VSVERT_STATIC  :  VS vert interface is not stalled yet SPI is asserting back pressure " = 0x19, 
                            "vgt_perf_VGT_SPI_VSWAVE_IS_EVENT  :  number of event transfers over the VS wave interface " = 0x1a, 
                            "vgt_perf_VGT_SPI_VSWAVE_SEND  :  number of VS wave transfers including events " = 0x1b, 
                            "vgt_perf_VGT_PA_EVENT_WINDOW_ACTIVE  :  PA clipp event window is active (time between START and STOP events during which clipp and clips counters are active) " = 0x1c, 
                            "vgt_perf_VGT_PA_CLIPV_SEND  :  number of transfers sent across the clipv interface. V stands for vector as in vertex vector or vertex wave. When the VGT sends a VS wave to the SPI it also sends a clipv transfer to the PA. The PA uses data on this interface to know how many positions to fetch after they are exported from the corresponding VS. " = 0x1d, 
                            "vgt_perf_VGT_PA_CLIPV_FIRSTVERT  :  increments with the first vector (also know as wave) of each draw packet " = 0x1e, 
                            "vgt_perf_VGT_PA_CLIPV_STALLED  :  ready to send a CLIPV transfer, but stalled by the PA. " = 0x1f, 
                            "vgt_perf_VGT_PA_CLIPV_STARVED_BUSY  :  CLIPV interface is starved while the VGT is busy " = 0x20, 
                            "vgt_perf_VGT_PA_CLIPV_STARVED_IDLE  :  CLIPV interface is starved while the VGT is idle, but clocks are on. Indicates that either the VGT/PA did it's work faster and thus is found idle more often or that no data is coming from earlier stages. " = 0x21, 
                            "vgt_perf_VGT_PA_CLIPV_STATIC  :  CLIPV interface is not stalled yet PA is asserting back pressure " = 0x22, 
                            "vgt_perf_VGT_PA_CLIPP_SEND  :  number of transfers across the CLIPP interface (primitives, tokens, and events) " = 0x23, 
                            "vgt_perf_VGT_PA_CLIPP_EOP  :  number of end of packet transfers (can accompany a valid or null primitive, but not an event) " = 0x24, 
                            "vgt_perf_VGT_PA_CLIPP_IS_EVENT  :  number of events sent to the PA " = 0x25, 
                            "vgt_perf_VGT_PA_CLIPP_NULL_PRIM  :  number of null primitives sent to the PA (these transfers carry information like eop or PC dealloc information) " = 0x26, 
                            "vgt_perf_VGT_PA_CLIPP_NEW_VTX_VECT  :  number of primitives that start a new VS wavefront/vector (used by Parameter Cache logic) " = 0x27, 
                            "vgt_perf_VGT_PA_CLIPP_STALLED  :  ready to send a CLIPP transfer, but stalled by the PA (means the max number of primitives are in flight). If there are stalls on this interface we don't have a deep enough FIFO to hide VS latency from the start to position export or there is back pressure from downstream. Usually the SC in this case, but sometimes due to clipping. " = 0x28, 
                            "vgt_perf_VGT_PA_CLIPP_STARVED_BUSY  :  CLIPP interface is starved while the VGT is busy (most accurate with VS only tests since these have the least time between the VGT going busy and the CLIPP receiving work. If looking at counts from a single draw use vgt_perf_vgt_pa_clipp_starved_after_work) " = 0x29, 
                            "vgt_perf_VGT_PA_CLIPP_STARVED_IDLE  :  CLIPP interface is starved while the VGT is idle, but clocks are on " = 0x2a, 
                            "vgt_perf_VGT_PA_CLIPP_STATIC  :  CLIPP interface is not stalled yet PA is asserting back pressure " = 0x2b, 
                            "vgt_perf_VGT_PA_CLIPS_SEND  :  number of transfers sent across the CLIPS interface (S stands for state data and there's a transfer per draw packet) " = 0x2c, 
                            "vgt_perf_VGT_PA_CLIPS_STALLED  :  ready to send a CLIPS transfer, but stalled by the PA.  If there are stalls here it means the draw calls are really small. " = 0x2d, 
                            "vgt_perf_VGT_PA_CLIPS_STARVED_BUSY  :  CLIPS interface is starved while the VGT is busy " = 0x2e, 
