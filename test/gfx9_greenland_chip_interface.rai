                            "TD_PERF_SEL_eight_phase_wavefront  :  dmask=3,5,6,9,a,c, wavefront was packed into an 8 phase packet for SP. " = 0x23, 
                            "TD_PERF_SEL_sixteen_phase_wavefront  :  dmask=7,b,d,e,f, wavefront was forwarded to SP in 16 phases. " = 0x24, 
                            "TD_PERF_SEL_four_phase_forward_wavefront  :  Count the wavefronts that were forwarded to SP in 4 phases (coalescable). " = 0x25, 
                            "TD_PERF_SEL_write_ack_wavefront  :  Count write acknowledgments, sent to SQ and not to SP. " = 0x26, 
                            "TD_PERF_SEL_RESERVED_39  :  RESERVED_39 " = 0x27, 
                            "TD_PERF_SEL_user_defined_border  :  Count the wavefronts that user defined border color was used. " = 0x28, 
                            "TD_PERF_SEL_white_border  :  Count the wavefronts that white border color was used. " = 0x29, 
                            "TD_PERF_SEL_opaque_black_border  :  Count the wavefronts that opaque black border color was used. " = 0x2a, 
