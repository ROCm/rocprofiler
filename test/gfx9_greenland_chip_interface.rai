                            "CB_PERF_SEL_RBP_EXPORT_8PIX_LIT_RIGHT  :  Number of 8PIX quad transfers that had only the right quad lit. " = 0x18e, 
                            "CB_PERF_SEL_RBP_SPLIT_MICROTILE  :  Number of 8PIX quad transfers that were split due to using DEPTH or ROTATED microtile mode. " = 0x18f, 
                            "CB_PERF_SEL_RBP_SPLIT_AA_SAMPLE_MASK  :  Number of 8PIX quad transfers that were split due to AA mode and not being either fully lit or fully unlit. " = 0x190, 
                            "CB_PERF_SEL_RBP_SPLIT_PARTIAL_TARGET_MASK  :  Number of 8PIX quad transfers that were split due to partial target mask in AA or non-AA with non-byte-aligned target mask. " = 0x191, 
                            "CB_PERF_SEL_RBP_SPLIT_LINEAR_ADDRESSING  :  Number of 8PIX quad transfers that were split due to the use of linear addressing. " = 0x192, 
                            "CB_PERF_SEL_RBP_SPLIT_AA_NO_FMASK_COMPRESS  :  Number of 8PIX quad transfers that were split due to AA mode and no FMask Compression enabled. " = 0x193, 
                            "CB_PERF_SEL_RBP_INSERT_MISSING_LAST_QUAD  :  Number of missing last quads of tile for MRTs needing CMask. " = 0x194, 
                            "CB_PERF_SEL_NACK_CM_READ  :  A NACK was received for a CMask memory read  request from RMI. " = 0x195, 
                            "CB_PERF_SEL_NACK_CM_WRITE  :  A NACK was received for a CMask memory write request from RMI. " = 0x196, 
