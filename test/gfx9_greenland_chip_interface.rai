CB_COLOR_CONTROL   <GpuF0Reg:0x28808> <GpuF1Reg:0x28808>   32    {
    DISABLE_DUAL_QUAD  0:0  NUM ;
    DEGAMMA_ENABLE  3:3  NUM ;
    MODE  6:4  ALPHA {"CB_DISABLE  :  Disables drawing to color buffer.  Causes DB to not send tiles/quads to CB.  CB itself ignores this field. " = 0x0, 
                            "CB_NORMAL  :  Normal rendering mode. DB should send tiles and quads for pixel exports. " = 0x1, 
                            "CB_ELIMINATE_FAST_CLEAR  :  Fill fast cleared color surface locations with clear color. This will clear both CMask and DCC fast clears.  This does not imply a DCC_DECOMPRESS will be done. DB should send only tiles. " = 0x2, 
                            "CB_RESOLVE  :  Read from MRT0, average all samples, and write to MRT1, which is one-sample.  DB should send tiles and quads.  All pixels of a quad must have at least one sample lit. " = 0x3, 
                            "CB_DECOMPRESS  :  DEPRECATED " = 0x4, 
                            "CB_FMASK_DECOMPRESS  :  Decompress the FMASK buffer into a texture readable format.  A CB_ELIMINATE_FAST_CLEAR pass before this is unnecessary.  DB should send only tiles.

                                    If FMASK_COMPRESS_1FRAG_ONLY is also set, this decompresses all but 1 Fragment tiles for compressed FMask compatibility in Texture. " = 0x5, 
                            "CB_DCC_DECOMPRESS  :  Decompress any DCC compressed surfaces. This mode will also do an implicit CB_ELIMINATE_FAST_CLEAR and an implicit CB_FMASK_DECOMPRESS.  DB should only send tiles. " = 0x6 }  ;
    ROP3  23:16  ALPHA {"0x00: BLACKNESS " = 0x0, 
                            "0x05 " = 0x5, 
                            "0x0A " = 0xa, 
                            "0x0F " = 0xf, 
                            "0x11: NOTSRCERASE " = 0x11, 
                            "0x22 " = 0x22, 
                            "0x33: NOTSRCCOPY " = 0x33, 
                            "0x44: SRCERASE " = 0x44, 
