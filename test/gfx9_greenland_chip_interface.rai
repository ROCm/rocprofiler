                            "vgt_perf_gsprim_stalled_gs_event  :  gsprim transfers are stalled because of events " = 0x48, 
                            "vgt_perf_gsprim_stalled_esvert  :  gsprim transfers are stalled because of ES vert interface is full " = 0x49, 
