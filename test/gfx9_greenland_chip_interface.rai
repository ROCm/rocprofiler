 	 // 0/0
 	 D.d = 0xfff8_0000_0000_0000;
 else if (abs(S1.d) == abs(S2.d) == +-INF)
 	 // inf/inf
 	 D.d = 0xfff8_0000_0000_0000;
 else if (S1.d == 0 || abs(S2.d) == +-INF)
 	 // x/0, or inf/y
 	 D.d = sign_out ? -INF : +INF;
 else if (abs(S1.d) == +-INF || S2.d == 0)
 	 // x/inf, 0/y
 	 D.d = sign_out ? -0 : 0;
