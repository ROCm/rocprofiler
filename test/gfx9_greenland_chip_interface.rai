    PERF_SEL1  18:10  ALPHA {"RMI_PERF_SEL_NONE  :  Count nothing " = 0x0, 
                            "RMI_PERF_SEL_BUSY  :  Number of busy cycles " = 0x1, 
                            "RMI_PERF_SEL_REG_CLK_VLD  :  Number of cycles that the registre clock is enabled. " = 0x2, 
                            "RMI_PERF_SEL_DYN_CLK_CMN_VLD  :  Number of cycles that the common core clock is enabled. " = 0x3, 
