                            "vgt_perf_REUSED_ES_INDICES  :  number of reuse buffer hits when ES is the first stage. i.e. the pipeline is configured to have a VS and GS with no tessellation. " = 0x3b, 
                            "vgt_perf_VS_CACHE_HITS  :  number of parameter cache hits due to an API VS " = 0x3c, 
