                            "vgt_perf_vgt_spi_lsvert_static  :  LS vert pipe is static.  Sensitive to PERF_SEID_IGNORE_MASK " = 0x65, 
                            "vgt_perf_UNUSED102  :  UNUSED " = 0x66, 
                            "vgt_perf_UNUSED103  :  UNUSED " = 0x67, 
                            "vgt_perf_UNUSED104  :  UNUSED " = 0x68, 
                            "vgt_perf_vgt_spi_hsvert_valid  :  HS Vert is valid.  Sensitive to PERF_SEID_IGNORE_MASK " = 0x69, 
                            "vgt_perf_vgt_spi_hsvert_eov  :  HS vert end of vector is active.  Sensitive to PERF_SEID_IGNORE_MASK " = 0x6a, 
                            "vgt_perf_vgt_spi_hsvert_stalled  :  HS vert pipe is stalled.  Sensitive to PERF_SEID_IGNORE_MASK " = 0x6b, 
