    ROUND_MODE  2:1  ALPHA {"0 = Truncate (OGL) " = 0x0, 
                            "1 = Round " = 0x1, 
                            "2 = Round to Even (D3D) " = 0x2, 
                            "3 = Round to Odd " = 0x3 }  ;
    QUANT_MODE  5:3  ALPHA {"0 = 16.8 fixed point. 1/16th   ( 4 fractional bits used) " = 0x0, 
                            "1 = 16.8 fixed point. 1/8th    ( 3 fractional bits used) " = 0x1, 
                            "2 = 16.8 fixed point. 1/4th    ( 2 fractional bits used) " = 0x2, 
                            "3 = 16.8 fixed point. 1/2      ( 1 fractional bit used) " = 0x3, 
                            "4 = 16.8 fixed point. 1        ( 0 fractional bits used) " = 0x4, 
                            "5 = 16.8 fixed point. 1/256th  ( 8 fractional bits) " = 0x5, 
                            "6 = 14.10 fixed point. 1/1024th (10 fractional bits) " = 0x6, 
