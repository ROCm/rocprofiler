                            "RMI_PERF_SEL_TCIW_REQ  :  Number of TCIW request event. " = 0xb7, 
                            "RMI_PERF_SEL_TCIW_BUSY  :  Number of TCIW busy cycles in a given window. " = 0xb8, 
