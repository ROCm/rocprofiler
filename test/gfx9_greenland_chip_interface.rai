                            "SQC_PERF_SEL_DCACHE_INVAL_ASYNC  :  Number of asynchronous invalidates (surface sync, register write, etc.) (No-Masking, unwindowed) " = 0x12d, 
                            "SQC_PERF_SEL_DCACHE_INVAL_VOLATILE_INST  :  Number of volatile cache invalidations caused by instructions (No-Masking) " = 0x12e, 
                            "SQC_PERF_SEL_DCACHE_INVAL_VOLATILE_ASYNC  :  Number of asynchronous volatile invalidates (surface sync, register write, etc.) (No-Masking, unwindowed) " = 0x12f, 
                            "SQC_PERF_SEL_DCACHE_WB_INST  :  Number of cache write-backs caused by instructions (No-Masking) " = 0x130, 
                            "SQC_PERF_SEL_DCACHE_WB_ASYNC  :  Number of asynchronous cache write-backs (surface sync, register write, etc.) (No-Masking, unwindowed) " = 0x131, 
                            "SQC_PERF_SEL_DCACHE_WB_VOLATILE_INST  :  Number of volatile cache write-backs caused by instructions (No-Masking) " = 0x132, 
                            "SQC_PERF_SEL_DCACHE_WB_VOLATILE_ASYNC  :  Number of asynchronous volatile cache write-backs (surface sync, register write, etc.) (No-Masking, unwindowed) " = 0x133, 
                            "SQC_PERF_SEL_DCACHE_INPUT_STALL_ARB_NO_GRANT  :  Number of arbitration stalls due to lost arbitration to other SQs.  (per-SQ, nondeterministic, unwindowed) " = 0x134, 
                            "SQC_PERF_SEL_DCACHE_INPUT_STALL_BANK_READYB  :  Number of arbitration stalls due to bank stalling.  (per-SQ, nondeterministic, unwindowed) " = 0x135, 
                            "SQC_PERF_SEL_DCACHE_CACHE_STALLED  :  Number of cache stalls.  (per-Bank, nondeterministic, unwindowed) " = 0x136, 
                            "SQC_PERF_SEL_DCACHE_CACHE_STALL_INFLIGHT_MAX  :  Number of cycles stalled on a hit CL but inflight counter is maxed out.  (per-Bank, nondeterministic, unwindowed) " = 0x137, 
                            "SQC_PERF_SEL_DCACHE_CACHE_STALL_OUTPUT  :  Number of cycles stalled at cache controller output.  (per-Bank, nondeterministic, unwindowed) " = 0x138, 
                            "SQC_PERF_SEL_DCACHE_CACHE_STALL_EVICT  :  Number of cycles stalled trying to do an evict.  (per-Bank, nondeterministic, unwindowed) " = 0x139, 
                            "SQC_PERF_SEL_DCACHE_CACHE_STALL_UNORDERED  :  Number of cycles stalled due to an unordered access conflict.  (per-Bank, nondeterministic, unwindowed) " = 0x13a, 
                            "SQC_PERF_SEL_DCACHE_CACHE_STALL_ALLOC_UNAVAILABLE  :  Number of cycles stalled due to not being able to allocate a line.  (per-Bank, nondeterministic, unwindowed) " = 0x13b, 
                            "SQC_PERF_SEL_DCACHE_CACHE_STALL_FORCE_EVICT  :  Number of cycles stalled due to having to force an eviction.  (per-Bank, nondeterministic, unwindowed) " = 0x13c, 
                            "SQC_PERF_SEL_DCACHE_CACHE_STALL_MULTI_FLUSH  :  Number of cycles stalled due to multiple flushes.  (per-Bank, nondeterministic, unwindowed) " = 0x13d, 
                            "SQC_PERF_SEL_DCACHE_CACHE_STALL_FLUSH_DONE  :  Number of cycles stalled inserting flush done tokens into pipe.  (per-Bank, nondeterministic, unwindowed) " = 0x13e, 
                            "SQC_PERF_SEL_DCACHE_CACHE_STALL_OUTPUT_MISS_FIFO  :  Number of cycles stalled because the miss FIFO is full.  (per-Bank, nondeterministic, unwindowed) " = 0x13f, 
                            "SQC_PERF_SEL_DCACHE_CACHE_STALL_OUTPUT_HIT_FIFO  :  Number of cycles stalled because a hit FIFO is full.  (per-Bank, nondeterministic, unwindowed) " = 0x140, 
                            "SQC_PERF_SEL_DCACHE_CACHE_STALL_OUTPUT_TC_IF  :  Number of cycles stalled because the TC request interface is stalled.  (per-Bank, nondeterministic, unwindowed) " = 0x141, 
                            "SQC_PERF_SEL_DCACHE_STALL_OUTXBAR_ARB_NO_GRANT  :  Number of arbitration stalls due to lost arbitration for the output port.  (per-Bank, nondeterministic, unwindowed) " = 0x142, 
                            "SQC_PERF_SEL_DCACHE_REQ_READ_1  :  Number of constant cache 1 dw read requests.  (per-SQ) " = 0x143, 
                            "SQC_PERF_SEL_DCACHE_REQ_READ_2  :  Number of constant cache 2 dw read requests.  (per-SQ) " = 0x144, 
                            "SQC_PERF_SEL_DCACHE_REQ_READ_4  :  Number of constant cache 4 dw read requests.  (per-SQ) " = 0x145, 
                            "SQC_PERF_SEL_DCACHE_REQ_READ_8  :  Number of constant cache 8 dw read requests.  (per-SQ) " = 0x146, 
                            "SQC_PERF_SEL_DCACHE_REQ_READ_16  :  Number of constant cache 16 dw read requests.  (per-SQ) " = 0x147, 
                            "SQC_PERF_SEL_DCACHE_REQ_TIME  :  Number of constant cache timestamp requests.  (per-SQ) " = 0x148, 
                            "SQC_PERF_SEL_DCACHE_REQ_WRITE_1  :  Number of constant cache 1 dw write requests.  (per-SQ) " = 0x149, 
                            "SQC_PERF_SEL_DCACHE_REQ_WRITE_2  :  Number of constant cache 2 dw write requests.  (per-SQ) " = 0x14a, 
                            "SQC_PERF_SEL_DCACHE_REQ_WRITE_4  :  Number of constant cache 4 dw write requests.  (per-SQ) " = 0x14b, 
                            "SQC_PERF_SEL_DCACHE_REQ_ATC_PROBE  :  Number of constant cache atc probe requests.  (per-SQ) " = 0x14c, 
                            "SQC_PERF_SEL_SQ_DCACHE_REQS  :  Number of constant requests from SQ before any serialization (per-SQ) " = 0x14d, 
                            "SQC_PERF_SEL_DCACHE_FLAT_REQ  :  Number of constant flat requests (per-SQ) " = 0x14e, 
                            "SQC_PERF_SEL_DCACHE_NONFLAT_REQ  :  Number of constant non-flat requests (per-SQ) " = 0x14f, 
                            "SQC_PERF_SEL_ICACHE_INFLIGHT_LEVEL  :  Level Counter: # total outstanding transactions in instruction cache (per-SQ, nondeterministic) " = 0x150, 
                            "SQC_PERF_SEL_DCACHE_INFLIGHT_LEVEL  :  Level Counter: # total outstanding transactions in data cache (per-SQ, nondeterministic) " = 0x151, 
                            "SQC_PERF_SEL_TC_INFLIGHT_LEVEL  :  Level Counter: total outstanding requests to TC (No-Masking, nondeterministic) " = 0x152, 
                            "SQC_PERF_SEL_ICACHE_TC_INFLIGHT_LEVEL  :  Level Counter: # of outstanding instruction requests to TC (No-Masking, nondeterministic) " = 0x153, 
                            "SQC_PERF_SEL_DCACHE_TC_INFLIGHT_LEVEL  :  Level Counter: # of outstanding data requests to TC (No-Masking, nondeterministic) " = 0x154, 
                            "SQC_PERF_SEL_ICACHE_GATCL1_TRANSLATION_MISS  :  Total ICACHE gatcl1 translation misses " = 0x155, 
                            "SQC_PERF_SEL_ICACHE_GATCL1_PERMISSION_MISS  :  Total ICACHE gatcl1 permission misses " = 0x156, 
                            "SQC_PERF_SEL_ICACHE_GATCL1_TRANSLATION_HIT  :  Total ICACHE gatcl1 translation hits " = 0x157, 
                            "SQC_PERF_SEL_ICACHE_GATCL1_REQUEST  :  Total ICACHE CLIENT_ATCL1 NORMAL requestes " = 0x158, 
                            "SQC_PERF_SEL_ICACHE_GATCL1_STALL_INFLIGHT_MAX  :  Total ICACHE gatcl1 stalls due to inflight counter saturation " = 0x159, 
                            "SQC_PERF_SEL_ICACHE_GATCL1_STALL_LRU_INFLIGHT  :  Total ICACHE gatcl1 stalls due to LRU cache line with traffic inflight " = 0x15a, 
                            "SQC_PERF_SEL_ICACHE_GATCL1_LFIFO_FULL  :  Total ICACHE gatcl1 atcl2 latency hiding fifo full cycles " = 0x15b, 
                            "SQC_PERF_SEL_ICACHE_GATCL1_STALL_LFIFO_NOT_RES  :  Total ICACHE gatcl1 stalls due to atcl2 latency hiding fifo output not resident " = 0x15c, 
                            "SQC_PERF_SEL_ICACHE_GATCL1_STALL_ATCL2_REQ_OUT_OF_CREDITS  :  Total ICACHE gatcl1 stalls due to atcl2_req out of credits " = 0x15d, 
                            "SQC_PERF_SEL_ICACHE_GATCL1_ATCL2_INFLIGHT  :  The sum of ICACHE inflight ATCL1_ATCL2 requests per cycle " = 0x15e, 
                            "SQC_PERF_SEL_ICACHE_GATCL1_STALL_MISSFIFO_FULL  :  Total ICACHE gatcl1 stalls due to full miss fifo " = 0x15f, 
                            "SQC_PERF_SEL_DCACHE_GATCL1_TRANSLATION_MISS  :  Total DCACHE gatcl1 translation misses " = 0x160, 
                            "SQC_PERF_SEL_DCACHE_GATCL1_PERMISSION_MISS  :  Total DCACHE gatcl1 permission misses " = 0x161, 
                            "SQC_PERF_SEL_DCACHE_GATCL1_TRANSLATION_HIT  :  Total DCACHE gatcl1 translation hits " = 0x162, 
                            "SQC_PERF_SEL_DCACHE_GATCL1_REQUEST  :  Total DCACHE CLIENT_ATCL1 NORMAL requestes " = 0x163, 
                            "SQC_PERF_SEL_DCACHE_GATCL1_STALL_INFLIGHT_MAX  :  Total DCACHE gatcl1 stalls due to inflight counter saturation " = 0x164, 
                            "SQC_PERF_SEL_DCACHE_GATCL1_STALL_LRU_INFLIGHT  :  Total DCACHE gatcl1 stalls due to LRU cache line with traffic inflight " = 0x165, 
                            "SQC_PERF_SEL_DCACHE_GATCL1_LFIFO_FULL  :  Total DCACHE gatcl1 atcl2 latency hiding fifo full cycles " = 0x166, 
                            "SQC_PERF_SEL_DCACHE_GATCL1_STALL_LFIFO_NOT_RES  :  Total DCACHE gatcl1 stalls due to atcl2 latency hiding fifo output not resident " = 0x167, 
                            "SQC_PERF_SEL_DCACHE_GATCL1_STALL_ATCL2_REQ_OUT_OF_CREDITS  :  Total DCACHE gatcl1 stalls due to atcl2_req out of credits " = 0x168, 
                            "SQC_PERF_SEL_DCACHE_GATCL1_ATCL2_INFLIGHT  :  The sum of DCACHE inflight ATCL1_ATCL2 requests per cycle " = 0x169, 
                            "SQC_PERF_SEL_DCACHE_GATCL1_STALL_MISSFIFO_FULL  :  Total DCACHE gatcl1 stalls due to full miss fifo " = 0x16a, 
                            "SQC_PERF_SEL_DCACHE_GATCL1_STALL_MULTI_MISS  :  Total DCACHE gatcl1 stalls due to arbitrated multiple misses " = 0x16b, 
                            "SQC_PERF_SEL_DCACHE_GATCL1_HIT_FIFO_FULL  :  Total DCACHE gatcl1 hit fifo full cycles " = 0x16c, 
                            "SQC_PERF_SEL_ICACHE_UTCL1_INFLIGHT_LEVEL  :  Level Counter: # total transactions that are outstanding in UTCL1 of instruction cache (nondeterministic) " = 0x16d, 
                            "SQC_PERF_SEL_ICACHE_UTCL1_ALL_REQ  :  Total number of requests (all types) going to UTCL1 of instruction cache " = 0x16e, 
                            "SQC_PERF_SEL_ICACHE_UTCL2_INFLIGHT_LEVEL  :  Level Counter: # total transactions that are outstanding in UTCL2 and originating from instruction cache (nondeterministic) " = 0x16f, 
                            "SQC_PERF_SEL_ICACHE_UTCL2_ALL_REQ  :  Total number of requests (all types) going to UTCL2 and originating from instruction cache " = 0x170, 
                            "SQC_PERF_SEL_DCACHE_UTCL1_INFLIGHT_LEVEL  :  Level Counter: # total transactions that are outstanding in UTCL1 of data cache (per-SQ, nondeterministic) " = 0x171, 
                            "SQC_PERF_SEL_DCACHE_UTCL1_ALL_REQ  :  Total number of requests (all types) going to UTCL1 of data cache " = 0x172, 
                            "SQC_PERF_SEL_DCACHE_UTCL2_INFLIGHT_LEVEL  :  Level Counter: # total transactions that are outstanding in UTCL2 and originating from data cache (per-SQ, nondeterministic) " = 0x173, 
                            "SQC_PERF_SEL_DCACHE_UTCL2_ALL_REQ  :  Total number of requests (all types) going to UTCL2 and originating from data cache " = 0x174, 
                            "SQC_PERF_SEL_DUMMY_LAST  :  Just a placeholding enum to indicate the last SQC performance counter. Not a real performance counter. " = 0x175 }  ;
    SQC_BANK_MASK  15:12  NUM ;
    SQC_CLIENT_MASK  19:16  NUM ;
    SPM_MODE  23:20  ALPHA {"PERFMON_SPM_MODE_OFF  :  Disable streaming performance counters. " = 0x0, 
                            "PERFMON_SPM_MODE_16BIT_CLAMP  :  16 bit streaming mode with clamp and reset " = 0x1, 
                            "PERFMON_SPM_MODE_16BIT_NO_CLAMP  :  16 bit streaming mode with No clamp and No reset. " = 0x2, 
                            "PERFMON_SPM_MODE_32BIT_CLAMP  :  32 bit streaming mode with clamp and reset " = 0x3, 
                            "PERFMON_SPM_MODE_32BIT_NO_CLAMP  :  32 bit streaming mode with No clamp and No reset. " = 0x4, 
                            "PERFMON_SPM_MODE_RESERVED_5  :  Reserved spm mode. " = 0x5, 
                            "PERFMON_SPM_MODE_RESERVED_6  :  Reserved spm mode. " = 0x6, 
                            "PERFMON_SPM_MODE_RESERVED_7  :  Reserved spm mode. " = 0x7, 
                            "PERFMON_SPM_MODE_TEST_MODE_0  :  Spm test mode 0. " = 0x8, 
                            "PERFMON_SPM_MODE_TEST_MODE_1  :  Spm test mode 1. " = 0x9, 
                            "PERFMON_SPM_MODE_TEST_MODE_2  :  Spm test mode 2. " = 0xa }  ;
    SIMD_MASK  27:24  NUM ;
    PERF_MODE  31:28  ALPHA {"PERFMON_COUNTER_MODE_ACCUM  :  Accumulate increment values over enabled cycles. " = 0x0, 
                            "PERFMON_COUNTER_MODE_ACTIVE_CYCLES  :  Count the number of cycles with a nonzero increment value. " = 0x1, 
                            "PERFMON_COUNTER_MODE_MAX  :  Store the largest increment value received over cycles counted. " = 0x2, 
                            "PERFMON_COUNTER_MODE_DIRTY  :  Record whether a nonzero increment value was ever received. " = 0x3, 
                            "PERFMON_COUNTER_MODE_SAMPLE  :  Just record the latest increment vlaue. " = 0x4, 
                            "PERFMON_COUNTER_MODE_CYCLES_SINCE_FIRST_EVENT  :  Count the cycles since a nonzero increment value. " = 0x5, 
                            "PERFMON_COUNTER_MODE_CYCLES_SINCE_LAST_EVENT  :  Count the cycles since a zero increment value. " = 0x6, 
                            "PERFMON_COUNTER_MODE_CYCLES_GE_HI  :  Count the cycles with an increment greater than or equal to the value in the high bits. " = 0x7, 
                            "PERFMON_COUNTER_MODE_CYCLES_EQ_HI  :  Count the cycles with an increment equal to the value in the high bits. " = 0x8, 
                            "PERFMON_COUNTER_MODE_INACTIVE_CYCLES  :  Count the number of cycles with a zero increment value. " = 0x9, 
                            "PERFMON_COUNTER_MODE_RESERVED  :  This is here just so this is a 4 bit field in case we add modes in the future.  Don't use it. " = 0xf }  ;
};

SQ_PERFCOUNTER1_SELECT   <GpuF0Reg:0x36704> <GpuF1Reg:0x36704>   32    {
    PERF_SEL  8:0  ALPHA {"SQ_PERF_SEL_NONE  :  Don't count anything. " = 0x0, 
                            "SQ_PERF_SEL_ACCUM_PREV  :  For counter N, increment by the value of counter N-1.  Only accumulates once every 4 cycles. " = 0x1, 
                            "SQ_PERF_SEL_CYCLES  :  Clock cycles. (nondeterministic, per-simd, global) " = 0x2, 
                            "SQ_PERF_SEL_BUSY_CYCLES  :  Clock cycles while SQ is reporting that it is busy.  (nondeterministic, per-simd, global) " = 0x3, 
                            "SQ_PERF_SEL_WAVES  :  Count number of waves sent to SQs. (per-simd, emulated, global) " = 0x4, 
                            "SQ_PERF_SEL_LEVEL_WAVES  :  Track the number of waves.  Set ACCUM_PREV for the next counter to use this. (level, per-simd, global) " = 0x5, 
                            "SQ_PERF_SEL_WAVES_EQ_64  :  Count number of waves with exactly 64 active threads sent to SQs. (per-simd, emulated, global) " = 0x6, 
                            "SQ_PERF_SEL_WAVES_LT_64  :  Count number of waves with <64 active threads sent to SQs. (per-simd, emulated, global) " = 0x7, 
                            "SQ_PERF_SEL_WAVES_LT_48  :  Count number of waves with <48 active threads sent to SQs. (per-simd, emulated, global) " = 0x8, 
                            "SQ_PERF_SEL_WAVES_LT_32  :  Count number of waves sent <32 active threads sent to SQs. (per-simd, emulated, global) " = 0x9, 
                            "SQ_PERF_SEL_WAVES_LT_16  :  Count number of waves sent <16 active threads sent to SQs. (per-simd, emulated, global) " = 0xa, 
                            "SQ_PERF_SEL_WAVES_CU  :  Count number of waves sent to CUs. (per-simd, emulated) " = 0xb, 
                            "SQ_PERF_SEL_LEVEL_WAVES_CU  :  Track the number of waves.  Set ACCUM_PREV for the next counter to use this. (level, per-simd) " = 0xc, 
                            "SQ_PERF_SEL_BUSY_CU_CYCLES  :  Count quad-cycles each CU is busy. (nondeterministic, per-simd) " = 0xd, 
                            "SQ_PERF_SEL_ITEMS  :  Number of valid items per wave.  (per-simd, global) " = 0xe, 
                            "SQ_PERF_SEL_QUADS  :  Number of completely or partially covered quads per wave.  (per-simd, emulated, global) " = 0xf, 
                            "SQ_PERF_SEL_EVENTS  :  Number of events.  (unwindowed, emulated, global) " = 0x10, 
                            "SQ_PERF_SEL_SURF_SYNCS  :  Number of surface syncs.  (unwindowed, emulated, global) " = 0x11, 
                            "SQ_PERF_SEL_TTRACE_REQS  :  Number of thread trace requests.  (unwindowed, global, nondeterministic) " = 0x12, 
                            "SQ_PERF_SEL_TTRACE_INFLIGHT_REQS  :  Number of in-flight thread trace requests.  (nondeterministic, unwindowed, global) " = 0x13, 
                            "SQ_PERF_SEL_TTRACE_STALL  :  Number of cycles thread trace stalls stalled execution.  (nondeterministic, unwindowed, global) " = 0x14, 
                            "SQ_PERF_SEL_MSG_CNTR  :  Number of counter messages.  (nondeterministic, unwindowed, global) " = 0x15, 
                            "SQ_PERF_SEL_MSG_PERF  :  Number of perfcounter messages.  (nondeterministic, unwindowed), global " = 0x16, 
                            "SQ_PERF_SEL_MSG_GSCNT  :  Number of geometry messages.  (emulated, unwindowed, global) " = 0x17, 
                            "SQ_PERF_SEL_MSG_INTERRUPT  :  Number of interrupt messages.  (emulated, unwindowed, global) " = 0x18, 
                            "SQ_PERF_SEL_INSTS  :  Number of instructions issued. (per-simd, emulated) " = 0x19, 
                            "SQ_PERF_SEL_INSTS_VALU  :  Number of VALU instructions issued. (per-simd, emulated) " = 0x1a, 
                            "SQ_PERF_SEL_INSTS_VMEM_WR  :  Number of VMEM write instructions issued (including FLAT). (per-simd, emulated) " = 0x1b, 
                            "SQ_PERF_SEL_INSTS_VMEM_RD  :  Number of VMEM read instructions issued (including FLAT). (per-simd, emulated) " = 0x1c, 
                            "SQ_PERF_SEL_INSTS_VMEM  :  Number of VMEM instructions issued. (per-simd, emulated) " = 0x1d, 
                            "SQ_PERF_SEL_INSTS_SALU  :  Number of SALU instructions issued. (per-simd, emulated) " = 0x1e, 
                            "SQ_PERF_SEL_INSTS_SMEM  :  Number of SMEM instructions issued. (per-simd, emulated) " = 0x1f, 
                            "SQ_PERF_SEL_INSTS_FLAT  :  Number of FLAT instructions issued. (per-simd, emulated) " = 0x20, 
                            "SQ_PERF_SEL_INSTS_FLAT_LDS_ONLY  :  Number of FLAT instructions issued that read/wrote only from/to LDS (only works if EARLY_TA_DONE is enabled). (per-simd, emulated) " = 0x21, 
                            "SQ_PERF_SEL_INSTS_LDS  :  Number of LDS instructions issued (including FLAT). (per-simd, emulated) " = 0x22, 
                            "SQ_PERF_SEL_INSTS_GDS  :  Number of GDS instructions issued. (per-simd, emulated) " = 0x23, 
                            "SQ_PERF_SEL_INSTS_EXP  :  Number of EXP instructions issued, excluding skipped export instructions. (per-simd, emulated) " = 0x24, 
                            "SQ_PERF_SEL_INSTS_EXP_GDS  :  Number of EXP and GDS instructions issued, excluding skipped export instructions. (per-simd, emulated) " = 0x25, 
                            "SQ_PERF_SEL_INSTS_BRANCH  :  Number of Branch instructions issued. (per-simd, emulated) " = 0x26, 
                            "SQ_PERF_SEL_INSTS_SENDMSG  :  Number of Sendmsg instructions issued. (per-simd, emulated) " = 0x27, 
                            "SQ_PERF_SEL_INSTS_VSKIPPED  :  Number of vector instructions skipped. (per-simd, emulated) " = 0x28, 
                            "SQ_PERF_SEL_INST_LEVEL_VMEM  :  Number of in-flight VMEM instructions. Set next counter to ACCUM_PREV and divide by INSTS_VMEM for average latency.  Includes FLAT instructions. (per-simd, level, nondeterministic) " = 0x29, 
                            "SQ_PERF_SEL_INST_LEVEL_SMEM  :  Number of in-flight SMEM instructions (*2 load/store; *2 atomic; *2 memtime; *4 wb/inv). Set next counter to ACCUM_PREV and divide by INSTS_SMEM for average latency per smem request.  Falls slightly short of total request latency because some fetches are divided into two requests that may finish at different times and this counter collects the average latency of the two. (per-simd, level, nondeterministic) " = 0x2a, 
                            "SQ_PERF_SEL_INST_LEVEL_LDS  :  Number of in-flight LDS instructions. Set next counter to ACCUM_PREV and divide by INSTS_LDS for average latency. Includes FLAT instructions.  (per-simd, level, nondeterministic) " = 0x2b, 
                            "SQ_PERF_SEL_INST_LEVEL_GDS  :  Number of in-flight GDS instructions. Set next counter to ACCUM_PREV and divide by INSTS_GDS for average latency. (per-simd, level, nondeterministic) " = 0x2c, 
                            "SQ_PERF_SEL_INST_LEVEL_EXP  :  Number of in-flight EXP instructions. Set next counter to ACCUM_PREV and divide by INSTS_EXP for average latency. (per-simd, level, nondeterministic) " = 0x2d, 
                            "SQ_PERF_SEL_WAVE_CYCLES  :  Number of wave-cycles spent by waves in the CUs (per-simd, nondeterministic) " = 0x2e, 
                            "SQ_PERF_SEL_WAVE_READY  :  Number of wave-cycles waves were ready to execute the next instruction (per-simd, nondeterministic) " = 0x2f, 
                            "SQ_PERF_SEL_WAIT_CNT_VM  :  Number of wave-cycles spent waiting for VM counter. In units of 4 cycles.  (per-simd, nondeterministic) " = 0x30, 
                            "SQ_PERF_SEL_WAIT_CNT_LGKM  :  Number of wave-cycles spent waiting for LGKM counter. In units of 4 cycles.  (per-simd, nondeterministic) " = 0x31, 
                            "SQ_PERF_SEL_WAIT_CNT_EXP  :  Number of wave-cycles spent waiting for EXP counter. In units of 4 cycles.  (per-simd, nondeterministic) " = 0x32, 
                            "SQ_PERF_SEL_WAIT_CNT_ANY  :  Number of wave-cycles spent waiting for any counter. In units of 4 cycles.  (per-simd, nondeterministic) " = 0x33, 
                            "SQ_PERF_SEL_WAIT_BARRIER  :  Number of wave-cycles spent waiting for a barrier. In units of 4 cycles.  (per-simd, nondeterministic) " = 0x34, 
                            "SQ_PERF_SEL_WAIT_EXP_ALLOC  :  Number of wave-cycles spent waiting for export allocation (per-simd, nondeterministic) " = 0x35, 
                            "SQ_PERF_SEL_WAIT_SLEEP  :  Number of wave-cycles spent waiting for sleep to finish (per-simd, nondeterministic) " = 0x36, 
