                            "0x55: DSTINVERT " = 0x55, 
                            "0x5A: PATINVERT " = 0x5a, 
                            "0x5F " = 0x5f, 
                            "0x66: SRCINVERT " = 0x66, 
                            "0x77 " = 0x77, 
                            "0x88: SRCAND " = 0x88, 
                            "0x99 " = 0x99, 
                            "0xA0 " = 0xa0, 
