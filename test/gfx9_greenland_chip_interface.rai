    MASK_ES  11:9  ALPHA {"SQ_THREAD_TRACE_WAVE_MASK_NONE  :  Don't trace threads of this type " = 0x0, 
                            "SQ_THREAD_TRACE_WAVE_MASK_ALL  :  Trace target-CU details for all threads of this type when THREAD_TRACE is enabled " = 0x1 }  ;
    MASK_HS  14:12  ALPHA {"SQ_THREAD_TRACE_WAVE_MASK_NONE  :  Don't trace threads of this type " = 0x0, 
                            "SQ_THREAD_TRACE_WAVE_MASK_ALL  :  Trace target-CU details for all threads of this type when THREAD_TRACE is enabled " = 0x1 }  ;
    MASK_LS  17:15  ALPHA {"SQ_THREAD_TRACE_WAVE_MASK_NONE  :  Don't trace threads of this type " = 0x0, 
                            "SQ_THREAD_TRACE_WAVE_MASK_ALL  :  Trace target-CU details for all threads of this type when THREAD_TRACE is enabled " = 0x1 }  ;
    MASK_CS  20:18  ALPHA {"SQ_THREAD_TRACE_WAVE_MASK_NONE  :  Don't trace threads of this type " = 0x0, 
                            "SQ_THREAD_TRACE_WAVE_MASK_ALL  :  Trace target-CU details for all threads of this type when THREAD_TRACE is enabled " = 0x1 }  ;
    MODE  22:21  ALPHA {"SQ_THREAD_TRACE_MODE_OFF  :  Don't write any data to the the thread trace buffer regardless of the TRACE_CTRL setting. " = 0x0, 
                            "SQ_THREAD_TRACE_MODE_ON  :  Allow all waves to write to the thread trace buffer. " = 0x1 }  ;
    CAPTURE_MODE  24:23  ALPHA {"SQ_THREAD_TRACE_CAPTURE_MODE_ALL  :  Capture all data in ttrace buffer " = 0x0, 
                            "SQ_THREAD_TRACE_CAPTURE_MODE_SELECT  :  Capture only data between THREAD_TRACE_START/STOP events, including wave, event and register data. " = 0x1, 
                            "SQ_THREAD_TRACE_CAPTURE_MODE_SELECT_DETAIL  :  Always capture Global and Reference tokens, and capture detail (target) tokens only for waves created between THREAD_TRACE_START and _STOP events. " = 0x2 }  ;
    AUTOFLUSH_EN  25:25  ALPHA {"Disable autoflush " = 0x0, 
                            "Enable autoflush " = 0x1 }  ;
    TC_PERF_EN  26:26  ALPHA {"Disable perf_cntr_en to TC " = 0x0, 
                            "Enable perf_cntr_en to TC " = 0x1 }  ;
    ISSUE_MASK  28:27  ALPHA {"SQ_THREAD_TRACE_ISSUE_MASK_ALL  :  INST tokens report all instructions " = 0x0, 
                            "SQ_THREAD_TRACE_ISSUE_MASK_STALLED  :  INST tokens report only stalled instructions " = 0x1, 
                            "SQ_THREAD_TRACE_ISSUE_MASK_STALLED_AND_IMMED  :  INST tokens report only stalled and other (nop/wait/set_prio/vkip/skipped_exports) instructions " = 0x2, 
                            "SQ_THREAD_TRACE_ISSUE_MASK_IMMED  :  INST tokens report only other (nop/wait/set_prio/vkip/skipped exports/etc) instructions " = 0x3 }  ;
    TEST_MODE  29:29  ALPHA {"Normal operation " = 0x0, 
                            "Don't record time deltas so that we can do a bit-wise memory compare. " = 0x1 }  ;
    INTERRUPT_EN  30:30  ALPHA {"Disable interrupts " = 0x0, 
                            "Enable interrupts " = 0x1 }  ;
    WRAP  31:31  ALPHA {"Disable wrapping " = 0x0, 
                            "Enable wrapping " = 0x1 }  ;
};

