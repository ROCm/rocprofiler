VGT_EVENT_INITIATOR   <GpuF0Reg:0x28a90> <GpuF1Reg:0x28a90>   32  W {
    EVENT_TYPE  5:0  ALPHA {"Reserved_0x00  :  This event is reserved as a global no-op event " = 0x0, 
                            "SAMPLE_STREAMOUTSTATS1  :  Sample Streamout1 Statitics counters -- Inserted by the driver to request the GPU to sample counters associated with streamout.  The CP will subsequently write them to memory. " = 0x1, 
                            "SAMPLE_STREAMOUTSTATS2  :  Sample Streamout2 Statitics counters -- Inserted by the driver to request the GPU to sample counters associated with streamout.  The CP will subsequently write them to memory. " = 0x2, 
                            "SAMPLE_STREAMOUTSTATS3  :  Sample Streamout3 Statitics counters -- Inserted by the driver to request the GPU to sample counters associated with streamout.  The CP will subsequently write them to memory. " = 0x3, 
                            "CACHE_FLUSH_TS  :  Destination Cache Flush with Timestamp -- Inserted by the driver to cause the CBs, DBs, and SX to flush all prior rendering in any destination cache, wait for write confirm, then signal the CP. " = 0x4, 
                            "CONTEXT_DONE  :  Inserted by the CP on the first GFXDEC state update after a draw. " = 0x5, 
                            "CACHE_FLUSH  :  Destination Caches Flushed -- Inserted by the driver to cause the CBs, DBs, and SX to flush all prior rendering in any destination cache to memory (No Timestamp is Generated). " = 0x6, 
                            "CS_PARTIAL_FLUSH  :  Used to flush Compute Shader work after the CP in the VGT, SPI, SQ such that all previous CS work launched prior to this event will complete execution in the shader core and free all shader resources. " = 0x7, 
                            "VGT_STREAMOUT_SYNC  :  The driver should not insert this event unless it's required for a bug workaround. " = 0x8, 
                            "SET_FE_ID  :  Used internally between the WD and the SPI to sync up the Parameter Cache. CANNOT be inserted by the application/driver/user " = 0x9, 
                            "VGT_STREAMOUT_RESET  :  Resets internal streamout related registers and should be sent prior to a draw that has reprogrammed streamout registers. " = 0xa, 
                            "END_OF_PIPE_INCR_DE  :  End Of Pipe event used to increment the Draw Engine Counter. " = 0xb, 
                            "END_OF_PIPE_IB_END  :  End Of Pipe event used to indicate when the backend has finished processing the command buffer. " = 0xc, 
                            "RST_PIX_CNT  :  Reset SPI's auto Pixel Counter -- Inserted by the driver. " = 0xd, 
                            "BREAK_BATCH  :  Force the termination of a binning batch " = 0xe, 
                            "VS_PARTIAL_FLUSH  :  Used to flush all work between the CP and the ES, GS, VS shaders including the VGT. " = 0xf, 
                            "PS_PARTIAL_FLUSH  :  Used to flush all work between the CP and the ES, GS, VS, PS shaders including scan conversion, primitive assembly, and VGT. " = 0x10, 
                            "FLUSH_HS_OUTPUT  :  Flush Hull Shader Output -- Sent by the VGT after an HS threadgroup. Used to make sure all HS threadgroup data is processed before the corresponding DS threadgroup begins. " = 0x11, 
                            "FLUSH_DFSM  :  Causes the DFSM to flush all data from its FIFO " = 0x12, 
                            "RESET_TO_LOWEST_VGT  :  After this event, the next draw will be sent to the lowest enabled VGT irrespective of where the last draw left off. This event only resets the SC's PA select pointers when it is in legacy mode (not NGG pipeline mode). " = 0x13, 
                            "CACHE_FLUSH_AND_INV_TS_EVENT  :  Destination Cache Flush and Invalidate with Timestamp --  Inserted by the driver to cause the CBs, DBs, and SX to flush and invalidate all prior rendering in any destination cache, wait for write confirm, then signal the CP. " = 0x14, 
                            "ZPASS_DONE  :  (legacy event - new designs should use the PIXEL_PIPE_STAT_CONTROL/PIXEL_PIPE_STAT_DUMP events) Write ZPASS counts to memory -- Inserted by the driver to instruct the DBs to write out the ZPASS counters to memory.  Used to support DX10 occlusion queries. " = 0x15, 
                            "CACHE_FLUSH_AND_INV_EVENT  :  Destination Cache Flush and Invalidate -- Inserted by the driver to cause the CBs, DBs, and SX to flush and invalidated all prior rendering in any destination cache to memory (No Timestamp is Generated). " = 0x16, 
                            "PERFCOUNTER_START  :  Start enabled event based Performance counters -- Inserted by the driver. " = 0x17, 
                            "PERFCOUNTER_STOP  :  Stop enabled event based Performance counters that are event-enabled -- Inserted by the driver. " = 0x18, 
                            "PIPELINESTAT_START  :  Start pipeline/strmout stat -- Inserted by the driver. " = 0x19, 
                            "PIPELINESTAT_STOP  :  Stop pipeline/strmout stat  -- Inserted by the driver. " = 0x1a, 
                            "PERFCOUNTER_SAMPLE  :  Sample the performance counters of all blocks -- Inserted by the driver to read the performance counters. " = 0x1b, 
                            "Available_0x1c  :  Available for use " = 0x1c, 
                            "Available_0x1d  :  Available for use " = 0x1d, 
                            "SAMPLE_PIPELINESTAT  :  Sample Pipeline Statistics counters -- Inserted by the driver to request the GPU to sample counters associated with pipelinestats.  The CP will subsequently write them to memory. " = 0x1e, 
                            "SO_VGTSTREAMOUT_FLUSH  :  VGT Streamout Flush -- This event will cause VGT to update the read only offsets registers and then send a VGT_CP_strmout_flushed to instruct the CP to read the offsets. " = 0x1f, 
                            "SAMPLE_STREAMOUTSTATS  :  Sample Streamout0 Statitics counters -- Inserted by the driver to request the GPU to sample counters associated with streamout.  The CP will subsequently write them to memory. " = 0x20, 
                            "RESET_VTX_CNT  :  Reset Vertex Count -- Inserted by the driver to reset the auto index count for vertex count. There are tow counters one for gs and non-gs and these should be reset seperately " = 0x21, 
                            "BLOCK_CONTEXT_DONE  :  Block Managed State (SQCONSDEC) Context Done -- Inserted by the CP on the first SQCONSDEC constant update after a draw. " = 0x22, 
                            "CS_CONTEXT_DONE  :  Deprecated - will be removed soon - Context Done for CS -- Converted to CONTEXT_DONE event by the WD before it sends it as an event down the pipe.  Therefore, only the CP and VGT will be aware of this event. " = 0x23, 
                            "VGT_FLUSH  :  VGT Flush - Inserted by the driver to cause the VGT to be flushed.  Used when GS ring buffer sizes are changed " = 0x24, 
                            "TGID_ROLLOVER  :  Event created by the ADC to let the SPI know that the TG ID has hit its maximum value and started counting from '0' again " = 0x25, 
                            "SQ_NON_EVENT  :  SQ Non-Event,  this event is reserved for SQ " = 0x26, 
                            "SC_SEND_DB_VPZ  :  SC Send Depth Block VPort Z -- Inserted by the SC when it sends the vport array Zmin and Zmax values to the DBs. " = 0x27, 
                            "BOTTOM_OF_PIPE_TS  :  Bottom of the Pipe Timestamp -- Inserted by the driver to request a bottom of pipe timestamp be sent to memory, no flushing required. " = 0x28, 
                            "FLUSH_SX_TS  :  DEPRECATED -- unavailable " = 0x29, 
                            "DB_CACHE_FLUSH_AND_INV  :  DB Flush and Invalidate - Inserted by the driver when the depth surface is paged out of memory. " = 0x2a, 
                            "FLUSH_AND_INV_DB_DATA_TS  :  Flush and Invalidate DB's Data Cache Only - Inserted by the driver to cause the DB to flush and invalidate only its data cache, wait for write confirm, then signal the CP. The other destination caches must also signal the CP for this event.  All responses to the CP must be in the order the TS were received, regardless if the cache is required to otherwise act upon it. " = 0x2b, 
                            "FLUSH_AND_INV_DB_META  :  Flush and Invalidate DB's Meta (htile) Only - Inserted by the driver to cause the DB to flush and invalidate only its Meta cache. " = 0x2c, 
                            "FLUSH_AND_INV_CB_DATA_TS  :  Flush and Invalidate CB's Data Cache Only - Inserted by the driver to cause the CB to flush and invalidate only its data cache, wait for write confirm, then signal the CP. The other destination caches must also signal the CP for this event.  All responses to the CP must be in the order the TS were received, regardless if the cache is required to otherwise act upon it. " = 0x2d, 
                            "FLUSH_AND_INV_CB_META  :  Flush and Invalidate CB's Meta (cmask/fmask) Only -  Inserted by the driver to cause the CB to flush and invalidate only its Meta cache. " = 0x2e, 
                            "CS_DONE  :  Inserted by the driver using an EVENT_WRITE_EOS packet.  The SQ, in response, will generate a signal to indicate that all CS work prior to this point has completed. " = 0x2f, 
                            "PS_DONE  :  Inserted by the driver using an EVENT_WRITE_EOS packet.  The SQ, in response, will generate a signal to indicate that all PS work prior to this point has completed. " = 0x30, 
                            "FLUSH_AND_INV_CB_PIXEL_DATA  :  Flush and invalidate CB's pixel (render target) data in color cache.  Does not guarantee UAV(RAT) flush-and-inv, and does not flush the cmask/fmask cache either.  Typically would be inserted by the driver before resolving or expanding an MSAA buffer.  No wait-idle is necessary between this flush and the subsequent resolve/expand draw command. " = 0x31, 
                            "SX_CB_RAT_ACK_REQUEST  :  DEPRECATED -- unavailable " = 0x32, 
                            "THREAD_TRACE_START  :  Enable thread trace in SQ.  Inserted by the driver. " = 0x33, 
                            "THREAD_TRACE_STOP  :  Enable thread trace in SQ.  Inserted by the driver. " = 0x34, 
                            "THREAD_TRACE_MARKER  :  A non-functional marker event that will show up in the thread trace as both a register write and an event, enabling correlation between draw calls and traced waves.  Inserted by the driver or the CP ucode. " = 0x35, 
                            "THREAD_TRACE_FLUSH  :  Flush the thread trace buffer to memory.  The flush is not guaranteed to have completed until either (1) the GUI is idle, or (2) BOTH a subsequent timestamp have been returned and SQ_THREAD_TRACE_WPTR.BUSY reads 0. " = 0x36, 
                            "THREAD_TRACE_FINISH  :  Flush the thread trace buffer to memory and reset the memory write address to the value last written to SQ_THREAD_TRACE_BASE (which may change the destination buffer).  The flush is not guaranteed to have completed until either (1) the GUI is idle, or (2) BOTH a subsequent timestamp has been returned and SQ_THREAD_TRACE_WPTR.BUSY reads 0.  Only one of these events may be present in the pipeline at a given time. " = 0x37, 
                            "PIXEL_PIPE_STAT_CONTROL  :  Controls which pixel pipe counters to either dump or reset based on subsequent events. " = 0x38, 
                            "PIXEL_PIPE_STAT_DUMP  :  Dumps the currently selected pixel pipe counter to memory address specified in event. " = 0x39, 
                            "PIXEL_PIPE_STAT_RESET  :  Resets the currently select pixel pipe counter to default value. " = 0x3a, 
                            "CONTEXT_SUSPEND  :  Inserted by the WD when interleaving work for HP3D (High Priority Graphics). The suspend applies to the most recent state used for GFX and is inserted on any transition between Normal 3D and High Priority 3D draw calls. " = 0x3b, 
                            "OFFCHIP_HS_DEALLOC  :  Inserted by the WD after all the tess factors of a threadgroup are fetched. This is sent to all the VGTs and then to the SPIs (only on the ES/VS wave depending on which one was the DS). The SPIs will sync up on this event. Only one SPI will match the front end id and deallocate the corresponding offchip HS memory. " = 0x3c, 
                            "ENABLE_NGG_PIPELINE  :  Used to switch between the pipelines. The event informs the SC to only expect data from the PA in its SE and to not switch input FIFOs at EOPG.  The SC stays in this mode until another event switches it back to the other modeResets the front end to the lowest enabled one " = 0x3d, 
                            "ENABLE_LEGACY_PIPELINE  :  Used to switch between the pipelines. The event informs the SC to switch to legacy mode where EOPGs have a next_fe_id field which indicate which PA input FIFOs is to be used after each prim group is completed. The SC stays in this mode until another event switches it back to the other mode " = 0x3e, 
                            "Reserved_0x3f  :  Reserved -- available " = 0x3f }  ;
    ADDRESS_HI  26:10  NUM ;
    EXTENDED_EVENT  27:27  NUM ;
};

VGT_DMA_EVENT_INITIATOR   <GpuF0Reg:0x28b9c> <GpuF1Reg:0x28b9c>   32  W {
    EVENT_TYPE  5:0  ALPHA {"Reserved_0x00  :  This event is reserved as a global no-op event " = 0x0, 
                            "SAMPLE_STREAMOUTSTATS1  :  Sample Streamout1 Statitics counters -- Inserted by the driver to request the GPU to sample counters associated with streamout.  The CP will subsequently write them to memory. " = 0x1, 
                            "SAMPLE_STREAMOUTSTATS2  :  Sample Streamout2 Statitics counters -- Inserted by the driver to request the GPU to sample counters associated with streamout.  The CP will subsequently write them to memory. " = 0x2, 
                            "SAMPLE_STREAMOUTSTATS3  :  Sample Streamout3 Statitics counters -- Inserted by the driver to request the GPU to sample counters associated with streamout.  The CP will subsequently write them to memory. " = 0x3, 
                            "CACHE_FLUSH_TS  :  Destination Cache Flush with Timestamp -- Inserted by the driver to cause the CBs, DBs, and SX to flush all prior rendering in any destination cache, wait for write confirm, then signal the CP. " = 0x4, 
                            "CONTEXT_DONE  :  Inserted by the CP on the first GFXDEC state update after a draw. " = 0x5, 
                            "CACHE_FLUSH  :  Destination Caches Flushed -- Inserted by the driver to cause the CBs, DBs, and SX to flush all prior rendering in any destination cache to memory (No Timestamp is Generated). " = 0x6, 
                            "CS_PARTIAL_FLUSH  :  Used to flush Compute Shader work after the CP in the VGT, SPI, SQ such that all previous CS work launched prior to this event will complete execution in the shader core and free all shader resources. " = 0x7, 
                            "VGT_STREAMOUT_SYNC  :  The driver should not insert this event unless it's required for a bug workaround. " = 0x8, 
                            "SET_FE_ID  :  Used internally between the WD and the SPI to sync up the Parameter Cache. CANNOT be inserted by the application/driver/user " = 0x9, 
                            "VGT_STREAMOUT_RESET  :  Resets internal streamout related registers and should be sent prior to a draw that has reprogrammed streamout registers. " = 0xa, 
                            "END_OF_PIPE_INCR_DE  :  End Of Pipe event used to increment the Draw Engine Counter. " = 0xb, 
                            "END_OF_PIPE_IB_END  :  End Of Pipe event used to indicate when the backend has finished processing the command buffer. " = 0xc, 
                            "RST_PIX_CNT  :  Reset SPI's auto Pixel Counter -- Inserted by the driver. " = 0xd, 
                            "BREAK_BATCH  :  Force the termination of a binning batch " = 0xe, 
                            "VS_PARTIAL_FLUSH  :  Used to flush all work between the CP and the ES, GS, VS shaders including the VGT. " = 0xf, 
                            "PS_PARTIAL_FLUSH  :  Used to flush all work between the CP and the ES, GS, VS, PS shaders including scan conversion, primitive assembly, and VGT. " = 0x10, 
                            "FLUSH_HS_OUTPUT  :  Flush Hull Shader Output -- Sent by the VGT after an HS threadgroup. Used to make sure all HS threadgroup data is processed before the corresponding DS threadgroup begins. " = 0x11, 
                            "FLUSH_DFSM  :  Causes the DFSM to flush all data from its FIFO " = 0x12, 
                            "RESET_TO_LOWEST_VGT  :  After this event, the next draw will be sent to the lowest enabled VGT irrespective of where the last draw left off. This event only resets the SC's PA select pointers when it is in legacy mode (not NGG pipeline mode). " = 0x13, 
                            "CACHE_FLUSH_AND_INV_TS_EVENT  :  Destination Cache Flush and Invalidate with Timestamp --  Inserted by the driver to cause the CBs, DBs, and SX to flush and invalidate all prior rendering in any destination cache, wait for write confirm, then signal the CP. " = 0x14, 
                            "ZPASS_DONE  :  (legacy event - new designs should use the PIXEL_PIPE_STAT_CONTROL/PIXEL_PIPE_STAT_DUMP events) Write ZPASS counts to memory -- Inserted by the driver to instruct the DBs to write out the ZPASS counters to memory.  Used to support DX10 occlusion queries. " = 0x15, 
                            "CACHE_FLUSH_AND_INV_EVENT  :  Destination Cache Flush and Invalidate -- Inserted by the driver to cause the CBs, DBs, and SX to flush and invalidated all prior rendering in any destination cache to memory (No Timestamp is Generated). " = 0x16, 
                            "PERFCOUNTER_START  :  Start enabled event based Performance counters -- Inserted by the driver. " = 0x17, 
                            "PERFCOUNTER_STOP  :  Stop enabled event based Performance counters that are event-enabled -- Inserted by the driver. " = 0x18, 
                            "PIPELINESTAT_START  :  Start pipeline/strmout stat -- Inserted by the driver. " = 0x19, 
                            "PIPELINESTAT_STOP  :  Stop pipeline/strmout stat  -- Inserted by the driver. " = 0x1a, 
                            "PERFCOUNTER_SAMPLE  :  Sample the performance counters of all blocks -- Inserted by the driver to read the performance counters. " = 0x1b, 
                            "Available_0x1c  :  Available for use " = 0x1c, 
                            "Available_0x1d  :  Available for use " = 0x1d, 
                            "SAMPLE_PIPELINESTAT  :  Sample Pipeline Statistics counters -- Inserted by the driver to request the GPU to sample counters associated with pipelinestats.  The CP will subsequently write them to memory. " = 0x1e, 
                            "SO_VGTSTREAMOUT_FLUSH  :  VGT Streamout Flush -- This event will cause VGT to update the read only offsets registers and then send a VGT_CP_strmout_flushed to instruct the CP to read the offsets. " = 0x1f, 
                            "SAMPLE_STREAMOUTSTATS  :  Sample Streamout0 Statitics counters -- Inserted by the driver to request the GPU to sample counters associated with streamout.  The CP will subsequently write them to memory. " = 0x20, 
                            "RESET_VTX_CNT  :  Reset Vertex Count -- Inserted by the driver to reset the auto index count for vertex count. There are tow counters one for gs and non-gs and these should be reset seperately " = 0x21, 
                            "BLOCK_CONTEXT_DONE  :  Block Managed State (SQCONSDEC) Context Done -- Inserted by the CP on the first SQCONSDEC constant update after a draw. " = 0x22, 
                            "CS_CONTEXT_DONE  :  Deprecated - will be removed soon - Context Done for CS -- Converted to CONTEXT_DONE event by the WD before it sends it as an event down the pipe.  Therefore, only the CP and VGT will be aware of this event. " = 0x23, 
                            "VGT_FLUSH  :  VGT Flush - Inserted by the driver to cause the VGT to be flushed.  Used when GS ring buffer sizes are changed " = 0x24, 
                            "TGID_ROLLOVER  :  Event created by the ADC to let the SPI know that the TG ID has hit its maximum value and started counting from '0' again " = 0x25, 
                            "SQ_NON_EVENT  :  SQ Non-Event,  this event is reserved for SQ " = 0x26, 
                            "SC_SEND_DB_VPZ  :  SC Send Depth Block VPort Z -- Inserted by the SC when it sends the vport array Zmin and Zmax values to the DBs. " = 0x27, 
                            "BOTTOM_OF_PIPE_TS  :  Bottom of the Pipe Timestamp -- Inserted by the driver to request a bottom of pipe timestamp be sent to memory, no flushing required. " = 0x28, 
                            "FLUSH_SX_TS  :  DEPRECATED -- unavailable " = 0x29, 
                            "DB_CACHE_FLUSH_AND_INV  :  DB Flush and Invalidate - Inserted by the driver when the depth surface is paged out of memory. " = 0x2a, 
                            "FLUSH_AND_INV_DB_DATA_TS  :  Flush and Invalidate DB's Data Cache Only - Inserted by the driver to cause the DB to flush and invalidate only its data cache, wait for write confirm, then signal the CP. The other destination caches must also signal the CP for this event.  All responses to the CP must be in the order the TS were received, regardless if the cache is required to otherwise act upon it. " = 0x2b, 
                            "FLUSH_AND_INV_DB_META  :  Flush and Invalidate DB's Meta (htile) Only - Inserted by the driver to cause the DB to flush and invalidate only its Meta cache. " = 0x2c, 
                            "FLUSH_AND_INV_CB_DATA_TS  :  Flush and Invalidate CB's Data Cache Only - Inserted by the driver to cause the CB to flush and invalidate only its data cache, wait for write confirm, then signal the CP. The other destination caches must also signal the CP for this event.  All responses to the CP must be in the order the TS were received, regardless if the cache is required to otherwise act upon it. " = 0x2d, 
                            "FLUSH_AND_INV_CB_META  :  Flush and Invalidate CB's Meta (cmask/fmask) Only -  Inserted by the driver to cause the CB to flush and invalidate only its Meta cache. " = 0x2e, 
                            "CS_DONE  :  Inserted by the driver using an EVENT_WRITE_EOS packet.  The SQ, in response, will generate a signal to indicate that all CS work prior to this point has completed. " = 0x2f, 
                            "PS_DONE  :  Inserted by the driver using an EVENT_WRITE_EOS packet.  The SQ, in response, will generate a signal to indicate that all PS work prior to this point has completed. " = 0x30, 
                            "FLUSH_AND_INV_CB_PIXEL_DATA  :  Flush and invalidate CB's pixel (render target) data in color cache.  Does not guarantee UAV(RAT) flush-and-inv, and does not flush the cmask/fmask cache either.  Typically would be inserted by the driver before resolving or expanding an MSAA buffer.  No wait-idle is necessary between this flush and the subsequent resolve/expand draw command. " = 0x31, 
                            "SX_CB_RAT_ACK_REQUEST  :  DEPRECATED -- unavailable " = 0x32, 
                            "THREAD_TRACE_START  :  Enable thread trace in SQ.  Inserted by the driver. " = 0x33, 
                            "THREAD_TRACE_STOP  :  Enable thread trace in SQ.  Inserted by the driver. " = 0x34, 
                            "THREAD_TRACE_MARKER  :  A non-functional marker event that will show up in the thread trace as both a register write and an event, enabling correlation between draw calls and traced waves.  Inserted by the driver or the CP ucode. " = 0x35, 
                            "THREAD_TRACE_FLUSH  :  Flush the thread trace buffer to memory.  The flush is not guaranteed to have completed until either (1) the GUI is idle, or (2) BOTH a subsequent timestamp have been returned and SQ_THREAD_TRACE_WPTR.BUSY reads 0. " = 0x36, 
                            "THREAD_TRACE_FINISH  :  Flush the thread trace buffer to memory and reset the memory write address to the value last written to SQ_THREAD_TRACE_BASE (which may change the destination buffer).  The flush is not guaranteed to have completed until either (1) the GUI is idle, or (2) BOTH a subsequent timestamp has been returned and SQ_THREAD_TRACE_WPTR.BUSY reads 0.  Only one of these events may be present in the pipeline at a given time. " = 0x37, 
                            "PIXEL_PIPE_STAT_CONTROL  :  Controls which pixel pipe counters to either dump or reset based on subsequent events. " = 0x38, 
                            "PIXEL_PIPE_STAT_DUMP  :  Dumps the currently selected pixel pipe counter to memory address specified in event. " = 0x39, 
                            "PIXEL_PIPE_STAT_RESET  :  Resets the currently select pixel pipe counter to default value. " = 0x3a, 
                            "CONTEXT_SUSPEND  :  Inserted by the WD when interleaving work for HP3D (High Priority Graphics). The suspend applies to the most recent state used for GFX and is inserted on any transition between Normal 3D and High Priority 3D draw calls. " = 0x3b, 
                            "OFFCHIP_HS_DEALLOC  :  Inserted by the WD after all the tess factors of a threadgroup are fetched. This is sent to all the VGTs and then to the SPIs (only on the ES/VS wave depending on which one was the DS). The SPIs will sync up on this event. Only one SPI will match the front end id and deallocate the corresponding offchip HS memory. " = 0x3c, 
                            "ENABLE_NGG_PIPELINE  :  Used to switch between the pipelines. The event informs the SC to only expect data from the PA in its SE and to not switch input FIFOs at EOPG.  The SC stays in this mode until another event switches it back to the other modeResets the front end to the lowest enabled one " = 0x3d, 
                            "ENABLE_LEGACY_PIPELINE  :  Used to switch between the pipelines. The event informs the SC to switch to legacy mode where EOPGs have a next_fe_id field which indicate which PA input FIFOs is to be used after each prim group is completed. The SC stays in this mode until another event switches it back to the other mode " = 0x3e, 
                            "Reserved_0x3f  :  Reserved -- available " = 0x3f }  ;
    ADDRESS_HI  26:10  NUM ;
    EXTENDED_EVENT  27:27  NUM ;
};

