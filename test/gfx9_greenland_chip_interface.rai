    PERF_MODE2  27:24  ALPHA {"PERFMON_COUNTER_MODE_ACCUM  :  Accumulate increment values over enabled cycles. " = 0x0, 
                            "PERFMON_COUNTER_MODE_ACTIVE_CYCLES  :  Count the number of cycles with a nonzero increment value. " = 0x1, 
                            "PERFMON_COUNTER_MODE_MAX  :  Store the largest increment value received over cycles counted. " = 0x2, 
                            "PERFMON_COUNTER_MODE_DIRTY  :  Record whether a nonzero increment value was ever received. " = 0x3, 
                            "PERFMON_COUNTER_MODE_SAMPLE  :  Just record the latest increment vlaue. " = 0x4, 
                            "PERFMON_COUNTER_MODE_CYCLES_SINCE_FIRST_EVENT  :  Count the cycles since a nonzero increment value. " = 0x5, 
                            "PERFMON_COUNTER_MODE_CYCLES_SINCE_LAST_EVENT  :  Count the cycles since a zero increment value. " = 0x6, 
                            "PERFMON_COUNTER_MODE_CYCLES_GE_HI  :  Count the cycles with an increment greater than or equal to the value in the high bits. " = 0x7, 
                            "PERFMON_COUNTER_MODE_CYCLES_EQ_HI  :  Count the cycles with an increment equal to the value in the high bits. " = 0x8, 
                            "PERFMON_COUNTER_MODE_INACTIVE_CYCLES  :  Count the number of cycles with a zero increment value. " = 0x9, 
                            "PERFMON_COUNTER_MODE_RESERVED  :  This is here just so this is a 4 bit field in case we add modes in the future.  Don't use it. " = 0xf }  ;
    PERF_MODE3  31:28  ALPHA {"PERFMON_COUNTER_MODE_ACCUM  :  Accumulate increment values over enabled cycles. " = 0x0, 
                            "PERFMON_COUNTER_MODE_ACTIVE_CYCLES  :  Count the number of cycles with a nonzero increment value. " = 0x1, 
                            "PERFMON_COUNTER_MODE_MAX  :  Store the largest increment value received over cycles counted. " = 0x2, 
                            "PERFMON_COUNTER_MODE_DIRTY  :  Record whether a nonzero increment value was ever received. " = 0x3, 
                            "PERFMON_COUNTER_MODE_SAMPLE  :  Just record the latest increment vlaue. " = 0x4, 
                            "PERFMON_COUNTER_MODE_CYCLES_SINCE_FIRST_EVENT  :  Count the cycles since a nonzero increment value. " = 0x5, 
                            "PERFMON_COUNTER_MODE_CYCLES_SINCE_LAST_EVENT  :  Count the cycles since a zero increment value. " = 0x6, 
                            "PERFMON_COUNTER_MODE_CYCLES_GE_HI  :  Count the cycles with an increment greater than or equal to the value in the high bits. " = 0x7, 
                            "PERFMON_COUNTER_MODE_CYCLES_EQ_HI  :  Count the cycles with an increment equal to the value in the high bits. " = 0x8, 
                            "PERFMON_COUNTER_MODE_INACTIVE_CYCLES  :  Count the number of cycles with a zero increment value. " = 0x9, 
                            "PERFMON_COUNTER_MODE_RESERVED  :  This is here just so this is a 4 bit field in case we add modes in the future.  Don't use it. " = 0xf }  ;
};

TCC_PERFCOUNTER2_SELECT   <GpuF0Reg:0x36e10> <GpuF1Reg:0x36e10>   32    {
    PERF_SEL  9:0  ALPHA {"TCC_PERF_SEL_NONE  :  Don't count anything. " = 0x0, 
                            "TCC_PERF_SEL_CYCLE  :  Number of cycles.  Not windowable. " = 0x1, 
                            "TCC_PERF_SEL_BUSY  :  Number of cycles we have a request pending.  Not windowable. " = 0x2, 
                            "TCC_PERF_SEL_REQ  :  Number of requests of all types.  This is measured at the tag block.  This may be more than the number of requests arriving at the TCC, but it is a good indication of the total amount of work that needs to be performed. " = 0x3, 
                            "TCC_PERF_SEL_STREAMING_REQ  :  Number of streaming requests.  This is measured at the tag block. " = 0x4, 
                            "TCC_PERF_SEL_COMPRESSED_REQ  :  Number of compressed requests.  This includes requests that read 0 bytes of compressed data.  Metadata requests are not included.  This is measured at the tag block. " = 0x5, 
                            "TCC_PERF_SEL_COMPRESSED_0_REQ  :  Number of compressed requests that read 0 bytes of compressed data.  Metadata requests are not included.  This is measured at the tag block. " = 0x6, 
                            "TCC_PERF_SEL_COMPRESSED_32_REQ  :  Number of compressed requests that read 32 bytes of compressed data.  Metadata requests are not included.  This is measured at the tag block. " = 0x7, 
                            "TCC_PERF_SEL_METADATA_REQ  :  Number of metadata requests.  This is measured at the tag block. " = 0x8, 
                            "TCC_PERF_SEL_NC_REQ  :  The number of noncoherently cached requests.  This is measured at the tag block. " = 0x9, 
                            "TCC_PERF_SEL_UC_REQ  :  The number of uncached requests.  This is measured at the tag block. " = 0xa, 
                            "TCC_PERF_SEL_CC_REQ  :  The number of coherently cached requests.  This is measured at the tag block. " = 0xb, 
                            "TCC_PERF_SEL_PROBE  :  Number of probe requests.  Not windowable. " = 0xc, 
                            "TCC_PERF_SEL_PROBE_ALL  :  Number of external probe requests with with EA_TCC_preq_all== 1.  Not windowable. " = 0xd, 
                            "TCC_PERF_SEL_INTERNAL_PROBE  :  Number of self-probes spawned by TCC for CC writes/atomic operations.  Not windowable. " = 0xe, 
                            "TCC_PERF_SEL_READ  :  Number of read requests.  Compressed reads are included in this, but metadata reads are not included. " = 0xf, 
                            "TCC_PERF_SEL_WRITE  :  Number of write requests. " = 0x10, 
                            "TCC_PERF_SEL_ATOMIC  :  Number of atomic requests of all types. " = 0x11, 
                            "TCC_PERF_SEL_NOP_ACK  :  Number of NOP_ACK requests. " = 0x12, 
                            "TCC_PERF_SEL_NOP_RTN0  :  Number of NOP_RTN0 requests. " = 0x13, 
                            "TCC_PERF_SEL_HIT  :  Number of cache hits. " = 0x14, 
                            "TCC_PERF_SEL_SECTOR_HIT  :  Number of cache sector hits. " = 0x15, 
                            "TCC_PERF_SEL_MISS  :  Number of cache misses.  UC reads count as misses. " = 0x16, 
                            "TCC_PERF_SEL_DEWRITE_ALLOCATE_HIT  :  Number of times a read was performed on a cache line that had only been written into before.  This can only occur once for the life of a cache line. " = 0x17, 
                            "TCC_PERF_SEL_FULLY_WRITTEN_HIT  :  Number of times a 32-byte read from the EA was avoided because the cache sector was already fully written with data.  This can only occur once for the life of a cache sector. " = 0x18, 
                            "TCC_PERF_SEL_WRITEBACK  :  Number of lines written back to main memory. This includes writebacks of dirty lines and uncached write/atomic requests. " = 0x19, 
                            "TCC_PERF_SEL_LATENCY_FIFO_FULL  :  Number of cycles the latency fifo was full. " = 0x1a, 
                            "TCC_PERF_SEL_SRC_FIFO_FULL  :  Number of cycles the src fifo was expected to be full as measured at the IB block. " = 0x1b, 
                            "TCC_PERF_SEL_HOLE_FIFO_FULL  :  Number of cycles the hole fifos in the TCAs were expected to be full as measured at the IB block.  This is usually an indication that there was insufficient bandwidth available on the data bus for source data. " = 0x1c, 
                            "TCC_PERF_SEL_EA_WRREQ  :  Number of transactions (either 32-byte or 64-byte) going over the TC_EA_wrreq interface.  Atomics may travel over the same interface and are generally classified as write requests. This does not include probe commands. " = 0x1d, 
                            "TCC_PERF_SEL_EA_WRREQ_64B  :  Number of 64-byte transactions going (64-byte write or CMPSWAP) over the TC_EA_wrreq interface. " = 0x1e, 
                            "TCC_PERF_SEL_EA_WRREQ_PROBE_COMMAND  :  Number of probe commands going over the TC_EA_wrreq interface. " = 0x1f, 
                            "TCC_PERF_SEL_EA_WR_UNCACHED_32B  :  Number of 32-byte write/atomic going over the TC_EA_wrreq interface due to uncached traffic.  Note that CC mtypes can produce uncached requests, and those are included in this. A 64-byte request will be counted as 2 " = 0x20, 
                            "TCC_PERF_SEL_EA_WRREQ_STALL  :  Number of cycles a write request was stalled. " = 0x21, 
                            "TCC_PERF_SEL_EA_WRREQ_IO_CREDIT_STALL  :  Number of cycles a EA write request was stalled because the interface was out of IO credits. " = 0x22, 
                            "TCC_PERF_SEL_EA_WRREQ_GMI_CREDIT_STALL  :  Number of cycles a EA write request was stalled because the interface was out of GMI credits. " = 0x23, 
                            "TCC_PERF_SEL_EA_WRREQ_DRAM_CREDIT_STALL  :  Number of cycles a EA write request was stalled because the interface was out of DRAM credits. " = 0x24, 
                            "TCC_PERF_SEL_TOO_MANY_EA_WRREQS_STALL  :  Number of cycles the TCC could not send a EA write request because it already reached its maximum number of pending EA write requests. " = 0x25, 
                            "TCC_PERF_SEL_EA_WRREQ_LEVEL  :  The sum of the number of EA write requests in flight.  This is primarily meant for measure average EA write latency.  Average write latency = TCC_PERF_SEL_EA_WRREQ_LEVEL/TCC_PERF_SEL_EA_WRREQ. " = 0x26, 
                            "TCC_PERF_SEL_EA_ATOMIC  :  Number of transactions going over the TC_EA_wrreq interface that are actually atomic requests. " = 0x27, 
                            "TCC_PERF_SEL_EA_ATOMIC_LEVEL  :  The sum of the number of EA atomics in flight.  This is primarily meant for measure average EA atomic latency.  Average atomic latency = TCC_PERF_SEL_EA_WRREQ_ATOMIC_LEVEL/TCC_PERF_SEL_EA_WRREQ_ATOMIC. " = 0x28, 
                            "TCC_PERF_SEL_EA_RDREQ  :  Number of TCC/EA read requests (either 32-byte or 64-byte) " = 0x29, 
                            "TCC_PERF_SEL_EA_RDREQ_32B  :  Number of 32-byte TCC/EA read requests " = 0x2a, 
                            "TCC_PERF_SEL_EA_RD_UNCACHED_32B  :  Number of 32-byte TCC/EA read due to uncached traffic. A 64-byte request will be counted as 2 " = 0x2b, 
                            "TCC_PERF_SEL_EA_RD_MDC_32B  :  Number of 32-byte TCC/EA read due to MDC traffic.  A 64-byte request will be counted as 2 " = 0x2c, 
                            "TCC_PERF_SEL_EA_RD_COMPRESSED_32B  :  Number of 32-byte TCC/EA read due to compressed data reads.  This does not include MDC traffic.  A 64-byte request will be counted as 2 " = 0x2d, 
                            "TCC_PERF_SEL_EA_RDREQ_IO_CREDIT_STALL  :  Number of cycles there was a stall because the read request interface was out of IO credits.  Stalls occur regardless of whether a read needed to be performed or not. " = 0x2e, 
                            "TCC_PERF_SEL_EA_RDREQ_GMI_CREDIT_STALL  :  Number of cycles there was a stall because the read request interface was out of GMI credits.  Stalls occur regardless of whether a read needed to be performed or not. " = 0x2f, 
                            "TCC_PERF_SEL_EA_RDREQ_DRAM_CREDIT_STALL  :  Number of cycles there was a stall because the read request interface was out of DRAM credits.  Stalls occur regardless of whether a read needed to be performed or not. " = 0x30, 
                            "TCC_PERF_SEL_EA_RDREQ_LEVEL  :  The sum of the number of TCC/EA read requests in flight.   This is primarily meant for measure average EA read latency.  Average read latency = TCC_PERF_SEL_EA_RDREQ_LEVEL/TCC_PERF_SEL_EA_RDREQ. " = 0x31, 
                            "TCC_PERF_SEL_TAG_STALL  :  Number of cycles the normal request pipeline in the tag was stalled for any reason.  Normally, stalls of this nature are measured exactly from one point the pipeline, but that is not the case for this counter.  Probes can stall the pipeline at a variety of places, and there is no single point that can reasonably measure the total stalls accurately. " = 0x32, 
                            "TCC_PERF_SEL_TAG_WRITEBACK_FIFO_FULL_STALL  :  Number of cycles the normal request pipeline in the tag was stalled due to the writeback fifo within the tag block being full. " = 0x33, 
                            "TCC_PERF_SEL_TAG_MISS_NOTHING_REPLACEABLE_STALL  :  Number of cycles the normal request pipeline in the tag was stalled due to a cache miss and unavailabiliyt of a replaceable cache line. " = 0x34, 
                            "TCC_PERF_SEL_TAG_UNCACHED_WRITE_ATOMIC_FIFO_FULL_STALL  :  Number of cycles the normal request pipeline in the tag was stalled due to the uncached write/atomic fifo being full. " = 0x35, 
                            "TCC_PERF_SEL_TAG_NO_UNCACHED_WRITE_ATOMIC_ENTRIES_STALL  :  Number of cycles the normal request pipeline in the tag was stalled due to the lack of unused uncached write/atomic tracking entries. " = 0x36, 
                            "TCC_PERF_SEL_TAG_PROBE_STALL  :  Number of cycles the normal request pipeline in the tag was stalled due to the presence of a probe. " = 0x37, 
                            "TCC_PERF_SEL_TAG_PROBE_FILTER_STALL  :  Number of cycles the normal request pipeline in the tag was stalled due to the probe filter being in an inappropriate state. " = 0x38, 
                            "TCC_PERF_SEL_TAG_PROBE_FIFO_FULL_STALL  :  Number of cycles the normal request pipeline in the tag was stalled due to the probe fifo begin full. " = 0x39, 
                            "TCC_PERF_SEL_READ_RETURN_TIMEOUT  :  Number of bubbles requests sent to the TCA because a EA read return waited so long for a cache ram port that it timed out. " = 0x3a, 
                            "TCC_PERF_SEL_WRITEBACK_READ_TIMEOUT  :  Number of bubbles requests sent to the TCA because a writeback waited so long for a cache ram port that it timed out. " = 0x3b, 
                            "TCC_PERF_SEL_READ_RETURN_FULL_BUBBLE  :  Number of bubbles requests sent to the TCA to prevent the EA read return fifos from overflowing.  Not windowable. " = 0x3c, 
                            "TCC_PERF_SEL_BUBBLE  :  Total number of bubble requests sent to the TCA " = 0x3d, 
                            "TCC_PERF_SEL_RETURN_ACK  :  Number of times only an ack was sent on the return bus. " = 0x3e, 
                            "TCC_PERF_SEL_RETURN_DATA  :  Number of times only data was sent on the return bus. " = 0x3f, 
                            "TCC_PERF_SEL_RETURN_HOLE  :  Number of times only a hole was sent on the return bus. " = 0x40, 
                            "TCC_PERF_SEL_RETURN_ACK_HOLE  :  Number of times an ack and a hole were sent at the same time on the return bus. " = 0x41, 
                            "TCC_PERF_SEL_IB_REQ  :  Number of requests through the IB.  This measures the raw request count from graphics clients going to this TCC. " = 0x42, 
                            "TCC_PERF_SEL_IB_STALL  :  Number of cycles the IB output was stalled. " = 0x43, 
                            "TCC_PERF_SEL_IB_TAG_STALL  :  Number of cycles the IB output was stalled on the tag. " = 0x44, 
                            "TCC_PERF_SEL_IB_MDC_STALL  :  Number of cycles the IB output was stalled on the mdc. " = 0x45, 
                            "TCC_PERF_SEL_TCA_LEVEL  :  The sum of the number of requests sent to the TCA for output arbitration in flight.  Average TCA arbitration latency = TCC_PERF_SEL_TCA_LEVEL/TCC_PERF_SEL_REQ. " = 0x46, 
                            "TCC_PERF_SEL_HOLE_LEVEL  :  The sum of the number of hole requests in flight.  Average hole latency = TCC_PERF_SEL_HOLE_LEVEL/(TCC_PERF_SEL_WRITE+TCC_PERF_SEL_ATOMIC).  Not windowable. " = 0x47, 
                            "TCC_PERF_SEL_EA_RDRET_NACK  :  The number of EA read returns that were nacked. " = 0x48, 
                            "TCC_PERF_SEL_EA_WRRET_NACK  :  The number of EA write returns that were nacked. " = 0x49, 
                            "TCC_PERF_SEL_NORMAL_WRITEBACK  :  Number of writebacks due to requests that are not writeback requests. " = 0x4a, 
                            "TCC_PERF_SEL_TC_OP_WBL2_NC_WRITEBACK  :  Number of writebacks due to TC_OP_WBL2_NC requests. " = 0x4b, 
                            "TCC_PERF_SEL_TC_OP_WBINVL2_WRITEBACK  :  Number of writebacks due to TC_OP_WBINVL2 requests. " = 0x4c, 
                            "TCC_PERF_SEL_TC_OP_WBINVL2_NC_WRITEBACK  :  Number of writebacks due to TC_OP_WBINVL2_NC requests. " = 0x4d, 
                            "TCC_PERF_SEL_TC_OP_WBINVL2_SD_WRITEBACK  :  Number of writebacks due to TC_OP_WBINVL2_SD requests. " = 0x4e, 
                            "TCC_PERF_SEL_ALL_TC_OP_WB_WRITEBACK  :  Number of writebacks due to all TC_OP writeback requests. " = 0x4f, 
                            "TCC_PERF_SEL_NORMAL_EVICT  :  Number of evictions due to requests that are not invalidate or probe requests. " = 0x50, 
                            "TCC_PERF_SEL_TC_OP_WBL2_NC_EVICT  :  Number of evictions due to TC_OP_WBL2_NC requests. " = 0x51, 
                            "TCC_PERF_SEL_TC_OP_INVL2_NC_EVICT  :  Number of evictions due to TC_OP_INVL2_NC requests. " = 0x52, 
                            "TCC_PERF_SEL_TC_OP_WBINVL2_EVICT  :  Number of evictions due to TC_OP_WBINVL2 requests. " = 0x53, 
                            "TCC_PERF_SEL_TC_OP_WBINVL2_NC_EVICT  :  Number of evictions due to TC_OP_WBINVL2_NC requests. " = 0x54, 
                            "TCC_PERF_SEL_TC_OP_WBINVL2_SD_EVICT  :  Number of evictions due to TC_OP_WBINVL2_SD requests. " = 0x55, 
                            "TCC_PERF_SEL_ALL_TC_OP_INV_EVICT  :  Number of evictions due to all TC_OP invalidate requests. " = 0x56, 
                            "TCC_PERF_SEL_PROBE_EVICT  :  Number of evictions/invalidations due to probes. Not windowable. " = 0x57, 
                            "TCC_PERF_SEL_TC_OP_WBL2_NC_CYCLE  :  Number of cycles spent performing TC_OP_WBL2_NC requests. " = 0x58, 
                            "TCC_PERF_SEL_TC_OP_INVL2_NC_CYCLE  :  Number of cycles spent performing TC_OP_INVL2_NC requests. " = 0x59, 
