                            "RMI_PERF_SEL_TCIW_INFLIGHT_COUNT  :  Number of inflight entries to TCIW. Can be used to get average and max inflights to TCIW. " = 0xb3, 
                            "RMI_PERF_SEL_PRT_FIFO_NUM_USED  :  Number of used entries in PRT FIFO. Can be used to get average, max PRTs as well as PRT FIFO average latencies. " = 0xb4, 
                            "RMI_PERF_SEL_PRT_FIFO_REQ  :  Number of request events to PRT fifo. " = 0xb5, 
