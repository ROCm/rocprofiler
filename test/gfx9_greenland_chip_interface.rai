ATC_L2_CNTL   <GpuF0Reg:0xa000> <GpuF1Reg:0xa000>   32    {
    NUMBER_OF_TRANSLATION_READ_REQUESTS  1:0  NUM ;
    NUMBER_OF_TRANSLATION_WRITE_REQUESTS  4:3  NUM ;
    NUMBER_OF_TRANSLATION_READS_DEPENDS_ON_ADDR_MOD  6:6  NUM ;
    NUMBER_OF_TRANSLATION_WRITES_DEPENDS_ON_ADDR_MOD  7:7  NUM ;
    CACHE_INVALIDATE_MODE  10:8  NUM ;
    ENABLE_DEFAULT_PAGE_OUT_TO_SYSTEM_MEMORY  11:11  ALPHA {"default page to local FB memory (i.e., system=0, snoop=0) " = 0x0, 
                            "default page to system memory (i.e., system=1, snoop=1) " = 0x1 }  ;
};

ATC_L2_CNTL2   <GpuF0Reg:0xa004> <GpuF1Reg:0xa004>   32    {
    BANK_SELECT  5:0  NUM ;
    L2_CACHE_UPDATE_MODE  7:6  ALPHA {"Update only the cache that had original miss, or the cache determined by Bank Select from ATS return vector {4'vmid,36'virtualpageaddr} for speculative return " = 0x0, 
                            "Update both caches " = 0x1, 
                            "Update other cache if wildcard >= reference value (This value would not be validated in CI) " = 0x2, 
                            "reserved " = 0x3 }  ;
    ENABLE_L2_CACHE_LRU_UPDATE_BY_WRITE  8:8  ALPHA {"write does not update lru (This value would not be validated in CI) " = 0x0, 
                            "write updates lru " = 0x1 }  ;
    L2_CACHE_SWAP_TAG_INDEX_LSBS  11:9  NUM ;
    L2_CACHE_VMID_MODE  14:12  ALPHA {"xor vmid into the top bits of the cam address " = 0x0, 
                            "ignore vmid in cam calculation " = 0x1, 
                            "split the cache 2 ways using the lowest bit of vmid " = 0x2, 
                            "split the cache 4 ways using the lowest 2 bits of vmid " = 0x3, 
                            "split the cache 8 ways using vmid " = 0x4, 
                            "split the cache 16 ways using vmid " = 0x5 }  ;
    L2_CACHE_UPDATE_WILDCARD_REFERENCE_VALUE  20:15  NUM ;
};

ATC_L2_DEBUG   <GpuF0Reg:0xa008> <GpuF1Reg:0xa008>   32    {
    CREDITS_L2_ATS  6:0  NUM ;
    L2_MEM_SELECT  7:7  NUM ;
    CACHE_INDEX  19:8  NUM ;
    CACHE_SELECT  20:20  NUM ;
    CACHE_BANK_SELECT  21:21  NUM ;
    CACHE_WAY_SELECT  23:23  NUM ;
    CACHE_READ  25:25  NUM W;
    CACHE_INJECT_SOFT_PARITY_ERROR  26:26  NUM W;
    CACHE_INJECT_HARD_PARITY_ERROR  27:27  ALPHA {"normal operation " = 0x0, 
                            "the parity bit will be flipped on every write to the cache at address specified by ATC_L2_DEBUG.CACHE_INDEX. " = 0x1 }  ;
    IFIFO_SEND_DELAY  30:28  NUM ;
};

ATC_L2_DEBUG2   <GpuF0Reg:0xa00c> <GpuF1Reg:0xa00c>   32    {
    EFFECTIVE_CACHE_SIZE  4:0  NUM ;
