                            "SPI_PERF_RA_VS_LOCK  :  Arb cycles VS has a CU locked when !fits and active_cnt < threshold. Source is RA0 " = 0x86, 
                            "SPI_PERF_RA_GS_LOCK  :  Arb cycles GS has a CU locked when !fits and active_cnt < threshold. Source is RA0 " = 0x87, 
                            "SPI_PERF_RA_HS_LOCK  :  Arb cycles HS has a CU locked when !fits and active_cnt < threshold. Source is RA0 " = 0x88, 
                            "SPI_PERF_RA_CSG_LOCK  :  Arb cycles CSG has a CU locked when !fits and active_cnt < threshold. Source is RA0 " = 0x89, 
                            "SPI_PERF_RA_CSN_LOCK  :  Arb cycles CSN has a CU locked when !fits and active_cnt < threshold. Source is RA0 " = 0x8a, 
                            "SPI_PERF_RA_RSV_UPD  :  Cycles spent doing updates for reservation changes, Source is RA0 " = 0x8b, 
                            "SPI_PERF_EXP_ARB_COL_CNT  :  Sum of number of color exp requests pending each clk, Source is WB0 " = 0x8c, 
                            "SPI_PERF_EXP_ARB_PAR_CNT  :  Sum of number of parameter exp requests pending each clk, Source is WB0 " = 0x8d, 
                            "SPI_PERF_EXP_ARB_POS_CNT  :  Sum of number of position exp requests pending each clk, Source is WB0 " = 0x8e, 
                            "SPI_PERF_EXP_ARB_GDS_CNT  :  Sum of number of gds exp requests pending each clk, Source is WB0 " = 0x8f, 
                            "SPI_PERF_NUM_PS_COL_R0_EXPORTS  :  Number of PS color export grants in dwords for read 0, 
				        Requires SPI_DEBUG_CNTL.DEBUG_SH_SEL to select source,
					                    DEBUG_SH_SEL =0, source is from WB0 and COL0
					                    DEBUG_SH_SEL =1, source is from WB0 and COL1. " = 0x90, 
                            "SPI_PERF_NUM_PS_COL_R1_EXPORTS  :  Number of PS color export grants in dwords for read 1, 
				        Requires SPI_DEBUG_CNTL.DEBUG_SH_SEL to select source,
					                    DEBUG_SH_SEL =0, source is from WB0 and COL0
					                    DEBUG_SH_SEL =1, source is from WB0 and COL1. " = 0x91, 
                            "SPI_PERF_NUM_VS_POS_R0_EXPORTS  :  Number of VS position export grants in dwords for read 0, Source is WB0 " = 0x92, 
                            "SPI_PERF_NUM_VS_POS_R1_EXPORTS  :  Number of VS position export grants in dwords for read 1, Source is WB0 " = 0x93, 
                            "SPI_PERF_NUM_VS_PARAM_R0_EXPORTS  :  Number of VS parameter export grants in dwords for read 0, Source is WB0 " = 0x94, 
                            "SPI_PERF_NUM_VS_PARAM_R1_EXPORTS  :  Number of VS parameter export grants in dwords for read 1, Source is WB0 " = 0x95, 
                            "SPI_PERF_NUM_VS_GDS_R0_EXPORTS  :  Number of gds export grants in dwords for read 0, Source is WB0 " = 0x96, 
                            "SPI_PERF_NUM_VS_GDS_R1_EXPORTS  :  Number of gds export grants in dwords for read 1, Source is WB0 " = 0x97, 
                            "SPI_PERF_NUM_EXPGRANT_EXPORTS  :  Number of cycles export bus is busy, Source is WB0 " = 0x98, 
                            "SPI_PERF_CLKGATE_BUSY_STALL  :  Number of clocks with spi busy and not all_clocks_on " = 0x99, 
                            "SPI_PERF_CLKGATE_ACTIVE_STALL  :  Number of clocks with spim_active and not all_clocks_on. " = 0x9a, 
                            "SPI_PERF_CLKGATE_ALL_CLOCKS_ON  :  Number of clocks with all_clocks_on. " = 0x9b, 
                            "SPI_PERF_CLKGATE_CGTT_DYN_ON  :  Number of clocks with spi cgtt dyn clk on. " = 0x9c, 
                            "SPI_PERF_CLKGATE_CGTT_REG_ON  :  Number of clocks with spi cgtt reg clk on. " = 0x9d, 
                            "SPI_PERF_PIX_ALLOC_PEND_CNT  :  Sum of number of pixel alloc requests pending per clk, Source is WWC0 " = 0x9e, 
                            "SPI_PERF_PIX_ALLOC_SCB_STALL  :  Number of clks pix alloc stalled due to color scoreboard. Source is WWC0 " = 0x9f, 
                            "SPI_PERF_PIX_ALLOC_DB0_STALL  :  Number of clks pix alloc stalled due to db0 color buffer. Source is WWC0 " = 0xa0, 
                            "SPI_PERF_PIX_ALLOC_DB1_STALL  :  Number of clks pix alloc stalled due to db1 color buffer. Source is WWC0 " = 0xa1, 
                            "SPI_PERF_PIX_ALLOC_DB2_STALL  :  Number of clks pix alloc stalled due to db2 color buffer. Source is WWC0 " = 0xa2, 
                            "SPI_PERF_PIX_ALLOC_DB3_STALL  :  Number of clks pix alloc stalled due to db3 color buffer. Source is WWC0 " = 0xa3, 
                            "SPI_PERF_PC_ALLOC_ACCUM  :  Accumulation of PC space allocated during perf window. Divide by PC_ALLOC_CNT to get avg allocation duration of each PC line (VS alloc to PS dealloc). AKA pc_free_ptr- " = 0xa4, 
                            "SPI_PERF_GS_NGG_SE_HAS_BATON  :  Number of clocks this SE owns the baton " = 0xa5, 
                            "SPI_PERF_GS_NGG_SE_DOES_NOT_HAVE_BATON  :  Number of clocks this SE does not have the baton " = 0xa6, 
                            "SPI_PERF_GS_NGG_SE_FORWARDED_BATON  :  This SE has forwarded the baton " = 0xa7, 
                            "SPI_PERF_GS_NGG_SE_AT_SYNC_EVENT  :  Number of clocks this SE at sync event (enable_legacy, enable_ngg, reset_to_lowest_vgt or set_next_feid " = 0xa8, 
                            "SPI_PERF_GS_NGG_SE_SG_ALLOC_PC_SPACE_CNT  :  Allocation of PC space per GS subgroup by this SE " = 0xa9, 
                            "SPI_PERF_GS_NGG_SE_DEALLOC_PC_SPACE_CNT  :  De-Allocation of PC space as received from PS by this SE " = 0xaa, 
                            "SPI_PERF_GS_NGG_PC_FULL  :  This SE reports parameter cache is full " = 0xab, 
                            "SPI_PERF_GS_NGG_SE_SEND_GS_ALLOC  :  GS granting PC allocations per surviving wave on this SE " = 0xac, 
                            "SPI_PERF_GS_NGG_GS_ALLOC_FIFO_EMPTY  :  GS allocation fifo is empty - no GS waves pending allocation on this SE " = 0xad, 
                            "SPI_PERF_GSC_VTX_BUSY  :  vtx controller busy " = 0xae, 
                            "SPI_PERF_GSC_VTX_INPUT_STARVED  :  There are no more prims to process and VSRs are empty  " = 0xaf, 
                            "SPI_PERF_GSC_VTX_VSR_STALL  :  vtx controller stalled " = 0xb0, 
                            "SPI_PERF_GSC_VTX_VSR_FULL  :  all VSRs are full or being read by VGPR controller " = 0xb1, 
                            "SPI_PERF_GSC_VTX_CAC_BUSY  :  vtx controller writing to VSRs " = 0xb2, 
                            "SPI_PERF_ESC_VTX_BUSY  :  vtx controller busy " = 0xb3, 
                            "SPI_PERF_ESC_VTX_INPUT_STARVED  :  There are no more verts to process and VSRs are empty  " = 0xb4, 
                            "SPI_PERF_ESC_VTX_VSR_STALL  :  vtx controller stalled " = 0xb5, 
                            "SPI_PERF_ESC_VTX_VSR_FULL  :  all VSRs are full or being read by VGPR controller " = 0xb6, 
                            "SPI_PERF_ESC_VTX_CAC_BUSY  :  vtx controller writing to VSRs " = 0xb7, 
                            "SPI_PERF_SWC_PS_WR  :  Number of clocks to write PS waves to SGPRs (need to multiply this value by 4) " = 0xb8, 
                            "SPI_PERF_SWC_VS_WR  :  Number of clocks to write VS waves to SGPRs (need to multiply this value by 4) " = 0xb9, 
                            "SPI_PERF_SWC_GS_WR  :  Number of clocks to write GS waves to SGPRs (need to multiply this value by 4) " = 0xba, 
                            "SPI_PERF_SWC_HS_WR  :  Number of clocks to write HS waves to SGPRs (need to multiply this value by 4) " = 0xbb, 
                            "SPI_PERF_SWC_CSG_WR  :  Number of clocks to write CSG waves to SGPRs (need to multiply this value by 4) " = 0xbc, 
                            "SPI_PERF_SWC_CSC_WR  :  Number of clocks to write CSC waves to SGPRs (need to multiply this value by 4)
				        Requires SPI_DEBUG_CNTL.DEBUG_PIPE_SEL to select source,
                                                DEBUG_PIPE_SEL = 1 , source is CS1;
                                                DEBUG_PIPE_SEL = 2 , source is CS2;
                                                DEBUG_PIPE_SEL = 3 , source is CS3;
                                                default , source is CS0; " = 0xbd, 
                            "SPI_PERF_VWC_PS_WR  :  Number of clocks to write PS waves to VGPRs (need to multiply this value by 4) " = 0xbe, 
                            "SPI_PERF_VWC_VS_WR  :  Number of clocks to write VS waves to VGPRs (need to multiply this value by 4) " = 0xbf, 
                            "SPI_PERF_VWC_GS_WR  :  Number of clocks to write GS waves to VGPRs (need to multiply this value by 4) " = 0xc0, 
                            "SPI_PERF_VWC_HS_WR  :  Number of clocks to write HS waves to VGPRs (need to multiply this value by 4) " = 0xc1, 
                            "SPI_PERF_VWC_CSG_WR  :  Number of clocks to write CSG waves to VGPRs (need to multiply this value by 4) " = 0xc2, 
                            "SPI_PERF_VWC_CSC_WR  :  Number of clocks to write CSC waves to VGPRs (need to multiply this value by 4)
				        Requires SPI_DEBUG_CNTL.DEBUG_PIPE_SEL to select source,
                                                DEBUG_PIPE_SEL = 1 , source is CS1;
                                                DEBUG_PIPE_SEL = 2 , source is CS2;
                                                DEBUG_PIPE_SEL = 3 , source is CS3;
                                                default , source is CS0; " = 0xc3 }  ;
