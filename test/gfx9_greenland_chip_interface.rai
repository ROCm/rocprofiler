TD_CNTL   <GpuF0Reg:0x9494> <GpuF1Reg:0x9494>   32    {
    SYNC_PHASE_SH  1:0  NUM ;
    SYNC_PHASE_VC_SMX  5:4  NUM ;
    PAD_STALL_EN  8:8  NUM ;
    EXTEND_LDS_STALL  10:9  ALPHA {"0: leave default extendion - LDS_STALL_PHASE_ADJUST+2 " = 0x0, 
                            "1: Extend LDS stall by 1 more cycle - LDS_STALL_PHASE_ADJUST+3 " = 0x1, 
                            "2: Extend LDS stall by 2 more cycle - LDS_STALL_PHASE_ADJUST+4 " = 0x2, 
                            "3: Extend LDS stall by 3 more cycle - LDS_STALL_PHASE_ADJUST+5 " = 0x3 }  ;
    LDS_STALL_PHASE_ADJUST  12:11  ALPHA {"0: leave default delay - delay of 4 cycles, 1 input, 1 output, 2 programmable stages for repeaters " = 0x0, 
                            "1: Reduce LDS stall delay by 1 cycle - delay of 3 cycles, allow for 1 repeater " = 0x1, 
                            "2: Reduce LDS stall delay by 2 cycle - delay of 2 cycles, allow for 2 repeaters " = 0x2 }  ;
    PRECISION_COMPATIBILITY  15:15  NUM ;
    GATHER4_FLOAT_MODE  16:16  ALPHA {"0: Pass denorm/NaN untouched like mov operation " = 0x0, 
                            "1: Override denorm/NaN as in SAMPLE " = 0x1 }  ;
    LD_FLOAT_MODE  18:18  ALPHA {"Not supported " = 0x0 }  ;
