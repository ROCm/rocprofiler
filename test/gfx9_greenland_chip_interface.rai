    ACC_VIOLATION_BLOCK  2:1  ALPHA {"Specifies target of access violation: Bit[1] : ROM Reg access viol, Bit[0]: ROM access viol " = 0x0 }  R;
    ACC_VIOLATION_TYPE  4:3  ALPHA {"Specifies access type that caused an access violation. Bit[1]: Write access, Bit[0]: Read access " = 0x0 }  R;
    ACC_VIOLATION_PROT  7:5  ALPHA {"Specifies PROT value of access that caused an access violation " = 0x0 }  R;
    ACC_VIOLATION_UNIT_ID  13:8  ALPHA {"AXI Unit ID for master which triggered access violation. " = 0x0 }  R;
    ACC_VIOLATION_INIT_ID  21:14  ALPHA {"AXI Initiator ID for master which triggered access violation. " = 0x0 }  R;
    ROM_WRITE_DETECTED  24:24  ALPHA {"Write to ROM detected " = 0x1 }  R;
    UNSECURE_ROM_ACC_DETECTED  25:25  ALPHA {"Unsecure access to ROM detected " = 0x1 }  R;
